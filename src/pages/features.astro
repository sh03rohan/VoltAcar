---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import MissionStatement from '../components/sections/MissionStatement.astro';
import FeatureRow from '../components/sections/FeatureRow.astro';
import FeatureSlider from '../components/sections/FeatureSlider.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { site } from '../config/site';

import featuresHero from '../assets/images/features-hero.webp';
import featureRoad from '../assets/images/feature-road.webp';
import featureCabin from '../assets/images/feature-cabin.webp';
---

<BaseLayout
  title={`Features | ${site.name}`}
  description="Advanced technology, thoughtful design and intelligent safety features — a closer look at what makes every VoltACar drive safer, cleaner and more enjoyable."
>
  <Header slot="header" />

  {/* Figma #124:165 — the render sits 1701x888 at (-101.15, -62) of the band */}
  <PageHero
    title="Designed for Intelligent Electric Mobility"
    body="Discover how our advanced technology, thoughtful design, and innovative features make every drive safer, cleaner, and more enjoyable."
    image={featuresHero}
    scrim="radial-gradient(53.75% 110.26% at 80.88% 62.79%, rgba(19, 20, 0, 0) 0%, rgba(19, 20, 0, 0.43) 38%, rgba(19, 20, 0, 0.66) 63%, rgba(19, 20, 0, 0.83) 100%)"
    imageWidth={106.3125}
    imageLeft={-6.3219}
    imageTop={-7.9487}
    imageFocus="66% 50%"
    copyWidth={859}
    bodyWidth={803}
  />

  {/* Figma #129:443 — a white band holding the statement and, from 2.3, the
      two alternating blocks, 180 apart with 180 below them. */}
  <div class="features-intro">
    <MissionStatement statement="We are shaping the next generation of electric mobility — crafted for modern cities, everyday lives, and a cleaner future. Our mission is simple: make electric driving accessible, efficient, and human-centered, from compact designs to advanced technology." />

    {/* Figma #129:444 */}
    <FeatureRow
      title="Designed for Real Life, Powered by Innovation"
      body="VoltACar merges advanced electric performance with human-centered design. From everyday commutes to long adventures, every detail is thoughtfully engineered."
      image={featureRoad}
      imageAlt="A VoltACar travelling along an open highway at dusk"
      mediaSide="right"
      eager
    />

    {/* Figma #129:450 */}
    <FeatureRow
      title="Performance Meets Everyday Life"
      body="VoltACar delivers intelligent electric mobility with comfort and precision, designed to enhance every journey, near or far."
      image={featureCabin}
      imageAlt="The VoltACar cabin looking forward through the panoramic roof to a mountain range"
      mediaSide="left"
    />
  </div>

  {/* Figma #132:515 — the frame marks this track overflowScroll:["x"] */}
  <FeatureSlider />

  {/* Remaining Features sections follow in Sub-phase 2.5 onward. */}

  {/* Figma #266:15681 — global */}
  <Newsletter />

  {/* Figma #282:16790 — global */}
  <Footer slot="footer" />
</BaseLayout>

<style>
  /* The frame groups the statement and the alternating blocks into one white
     band: 180 between them and 180 below. The page itself is cream. */
  .features-intro {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    padding-bottom: var(--section-gap);
    background-color: var(--c-white);
  }
</style>

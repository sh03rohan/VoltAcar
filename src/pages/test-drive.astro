---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import Button from '../components/common/Button.astro';
import TextField from '../components/forms/TextField.astro';
import RadioGroup from '../components/forms/RadioGroup.astro';
import Checkbox from '../components/forms/Checkbox.astro';
import { site, forms, testDrive } from '../config/site';

import driveHero from '../assets/images/test-drive-hero.webp';

/* Same contract as the newsletter: an empty endpoint still validates and still
   shows its success state, it just never sends — which is what lets a buyer
   style and test the form before wiring anything up.
   With JS the submit is intercepted either way. Without it, and with no
   endpoint set, there is nowhere to post and the browser falls back to its own
   validation; `required` is left on every control for exactly that case. */
const action = forms.testDrive || undefined;

/* Nobody books a demo drive for yesterday. */
const today = new Date().toISOString().slice(0, 10);
---

<BaseLayout
  title={`Book a Demo Drive | ${site.name}`}
  description="Book your demo drive today and feel the innovation, comfort, and performance of our electric vehicles firsthand."
>
  <Header slot="header" />

  {/* Figma #115:115. One plate this time, not two, placed at the frame's own
      offsets. The scrim rect (#115:117) sits at y=-46 of the band and is 829
      tall, so its measured radius is restated here against the 780. */}
  <PageHero
    title="Experience the Future of Driving"
    body="Book your demo drive today and feel the innovation, comfort, and performance of our electric vehicles firsthand."
    image={driveHero}
    scrim="radial-gradient(53.8% 61.67% at 72.45% 67.91%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.43) 39%, rgba(19,20,0,0.83) 100%)"
    imageWidth={114.9375}
    imageLeft={-14.9375}
    imageTop={-14.1026}
    imageFocus="52% 50%"
    imageFocusNarrow="62% 50%"
    copyWidth={879}
    titleWidth={648}
    bodyWidth={565}
  />

  {/* Figma #118:546 — a white band, 80 above and below a 922 form. The frame
      gives it no heading of any kind, so one is added and hidden: a form this
      long needs a landmark, and a screen reader listing the page's sections
      should not find an unnamed one between the hero and the pitch. */}
  <section class="booking" aria-labelledby="booking-title">
    <h2 class="visually-hidden" id="booking-title">Book a demo drive</h2>

    <form
      class="booking__form"
      method="post"
      action={action}
      data-has-endpoint={action ? 'true' : 'false'}
      data-booking-form
    >
      <div class="booking__row">
        <TextField label="First name" name="firstName" autocomplete="given-name" required />
        <TextField label="Last name" name="lastName" autocomplete="family-name" required />
      </div>

      <div class="booking__row">
        <TextField
          label="Email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
        />
      </div>

      <div class="booking__row">
        <TextField
          label="Phone Number"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          required
        />
        <TextField
          label="Zip Code"
          name="zip"
          autocomplete="postal-code"
          inputmode="numeric"
          required
        />
      </div>

      {/* Figma #118:568 — the frame preselects the first address (#118:572
          is the set's Selected=True instance). */}
      <RadioGroup
        legend="Choose a location"
        name="location"
        options={[...testDrive.locations]}
        value={testDrive.locations[0]}
        required
      />

      <div class="booking__row">
        <TextField label="Date" name="date" type="date" min={today} required />
      </div>

      {/* Figma #120:165 — nothing is preselected here, so the group is a real
          choice rather than a default someone has to notice and change. */}
      <RadioGroup legend="Available Time" name="time" options={[...testDrive.times]} tight required />

      <div class="booking__foot">
        <Checkbox name="consent" required>
          By clicking “Book Now” below to book a demo drive, I authorize the company to contact me
          at the phone number provided about my demo drive and to give me more information. By
          booking a demo drive, I understand and agree to the <a href="/privacy-data">Terms of Use</a
          > and acknowledge the <a href="/privacy-data">Data Privacy Notice</a>.
        </Checkbox>

        <Button label="Book Now" type="submit" variant="dark" size="sm" />

        <p class="booking__status" data-booking-status role="status"></p>
      </div>
    </form>
  </section>

  {/* Figma #91:572 */}
  <Newsletter />

  {/* Figma #91:594 */}
  <Footer slot="footer" />
</BaseLayout>

<style>
  /* #118:546 — white, not the page's cream. It is the only band on the site
     that is, and it is what separates the form from the pitch below it. */
  .booking {
    padding-block: var(--sp-80);
    background-color: var(--c-white);
  }

  .booking__form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
    width: min(57.625rem, 100% - var(--gutter) * 2); /* 922 */
    margin-inline: auto;
  }

  /* One or two fields, sharing the row equally — the frame's #118:551 and
     #118:558 are the same frame with a different number of children. */
  .booking__row {
    display: flex;
    gap: var(--sp-32);
  }

  /* Figma #123:155: 16 between the consent and the button, and the consent
     block carries a further 16 below itself (#258:244). */
  .booking__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-32);
  }

  /* The lime that carries a success everywhere else on the site is 1.05:1 on
     white, so the confirmation is set in ink and the error keeps its own red.
     Both are announced by role="status" regardless. */
  .booking__status {
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .booking__status[data-state='error'] {
    color: var(--c-error-strong);
  }

  .booking__status:empty {
    display: none;
  }


  @media (max-width: 768px) {
    .booking__row {
      flex-direction: column;
      gap: var(--sp-24);
    }
  }
</style>

<script>
  import { wireForm, text, choice, consent, futureDate, EMAIL, ZIP, PHONE } from '../scripts/form';

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');

  if (form) {
    const input = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const group = (name: string) =>
      Array.from(form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`));
    /* Every control was given `aria-describedby` by its component, so the
       message element is found the same way for all of them. */
    const msgFor = (el: Element | null) => {
      const id = el?.getAttribute('aria-describedby');
      return id ? document.getElementById(id) : null;
    };
    const fieldMsg = (name: string) => msgFor(input(name));

    wireForm(form, {
      fields: [
        text(input('firstName'), fieldMsg('firstName'), 'Enter your first name.'),
        text(input('lastName'), fieldMsg('lastName'), 'Enter your last name.'),
        text(
          input('email'),
          fieldMsg('email'),
          'Enter your email address.',
          EMAIL,
          'Enter a valid email address.',
        ),
        text(
          input('phone'),
          fieldMsg('phone'),
          'Enter your phone number.',
          PHONE,
          'Enter a valid phone number.',
        ),
        text(input('zip'), fieldMsg('zip'), 'Enter your zip code.', ZIP, 'Enter a valid zip code.'),
        choice(
          group('location'),
          msgFor(form.querySelector('[data-radio-group]')),
          'Choose a location.',
        ),
        futureDate(
          input('date'),
          fieldMsg('date'),
          'Choose a date for your drive.',
          'Choose a date that has not already passed.',
        ),
        choice(
          group('time'),
          msgFor(form.querySelectorAll('[data-radio-group]')[1] ?? null),
          'Choose a time.',
        ),
        consent(
          input('consent'),
          fieldMsg('consent'),
          'Please agree to the terms before booking.',
        ),
      ].filter((f) => f !== null),
      status: form.querySelector<HTMLElement>('[data-booking-status]'),
      success: 'Thanks — your demo drive is booked. We’ll be in touch to confirm.',
    });
  }
</script>

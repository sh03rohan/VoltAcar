---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PostBody from '../../components/blog/PostBody.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { site } from '../../config/site';

import blogHero from '../../assets/images/blog-hero.webp';

/**
 * `/blog/<slug>` — Figma #83:527.
 *
 * Sits beside `[...page].astro`, which owns `/blog` and `/blog/2`. Astro ranks
 * a named parameter above a rest parameter, and the two generate disjoint sets
 * in any case: slugs here, page numbers there.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishedAt}
>
  <Header slot="header" />

  {/* Figma #83:528. The frame's hero is the listing hero's band note for note
      — the same two plates at the same offsets under the same scrim rect
      (#83:531 against #237:840) — so it takes the same asset rather than a
      second copy of it.

      What differs is the copy: no eyebrow, no CTA, a wider 1042 block, and a
      lead hung off its right edge instead of its left. */}
  <PageHero
    title={post.data.title}
    body={post.data.description}
    image={blogHero}
    scrim="radial-gradient(47.37% 112.31% at 77.35% 73.67%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.43) 46%, rgba(19,20,0,0.83) 100%)"
    imageFocus="70% 50%"
    imageFocusNarrow="100% 50%"
    copyWidth={1042}
    titleWidth={1102}
    bodyWidth={687}
    copyTop={250}
    leadAlign="end"
  />

  {/* Figma #263:981 — 80 below the hero. */}
  <article class="post-page">
    <PostBody>
      <Content />
    </PostBody>
  </article>

  {/* Figma #91:572 */}
  <Newsletter />

  {/* Figma #91:594 */}
  <Footer slot="footer" />
</BaseLayout>

<style>
  /* No inline padding: PostBody's own grid owns the gutter, so that a
     full-bleed figure can actually reach the edge of the page. */
  .post-page {
    padding-top: var(--section-gap-sm); /* 80 */
    padding-bottom: var(--section-gap); /* 180 */
  }
</style>

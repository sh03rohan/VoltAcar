---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHero from '../../components/sections/PageHero.astro';
import PostBody from '../../components/blog/PostBody.astro';
import BlogCard from '../../components/cards/BlogCard.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { site } from '../../config/site';

import blogHero from '../../assets/images/blog-hero.webp';

/**
 * `/blog/<slug>` — Figma #83:527.
 *
 * Sits beside `[...page].astro`, which owns `/blog` and `/blog/2`. Astro ranks
 * a named parameter above a rest parameter, and the two generate disjoint sets
 * in any case: slugs here, page numbers there.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  /* Same order as the listing, so "similar" means something a reader can see
     for themselves rather than a hidden score. */
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      /* The two that follow, wrapping past the end. The frames carry no tags
         or categories to match on, and taking the two newest instead would
         hand almost every post the same pair. Wrapping gives each one a
         different pair and can never link a post to itself — the filter is
         for collections of one or two, where the wrap comes back round. */
      similar: [1, 2]
        .map((n) => posts[(i + n) % posts.length])
        .filter((p) => p.id !== post.id),
    },
  }));
};

const { post, similar } = Astro.props as {
  post: CollectionEntry<'blog'>;
  similar: CollectionEntry<'blog'>[];
};
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | ${site.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishedAt}
>
  <Header slot="header" />

  {/* Figma #83:528. The frame's hero is the listing hero's band note for note
      — the same two plates at the same offsets under the same scrim rect
      (#83:531 against #237:840) — so it takes the same asset rather than a
      second copy of it.

      What differs is the copy: no eyebrow, no CTA, a wider 1042 block, and a
      lead hung off its right edge instead of its left. */}
  <PageHero
    title={post.data.title}
    body={post.data.description}
    image={blogHero}
    scrim="radial-gradient(47.37% 112.31% at 77.35% 73.67%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.43) 46%, rgba(19,20,0,0.83) 100%)"
    imageFocus="70% 50%"
    imageFocusNarrow="100% 50%"
    copyWidth={1042}
    titleWidth={1102}
    bodyWidth={687}
    copyTop={250}
    leadAlign="end"
  />

  {/* Figma #263:981 — 80 below the hero. */}
  <article class="post-page">
    <PostBody>
      <Content />
    </PostBody>
  </article>

  {/* Figma #85:159 — 180 below the article, 180 above the newsletter. Hidden
      rather than left empty on a collection too small to fill it. */}
  {
    similar.length > 0 && (
      <section class="similar" aria-labelledby="similar-title">
        <div class="container">
          <h2 class="similar__title" id="similar-title">
            Similar Blog
          </h2>

          <div class="similar__list">
            {similar.map((entry) => (
              <BlogCard
                title={entry.data.title}
                description={entry.data.description}
                href={`/blog/${entry.id}`}
                cover={entry.data.cover}
                coverAlt={entry.data.coverAlt}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Figma #91:572 */}
  <Newsletter />

  {/* Figma #91:594 */}
  <Footer slot="footer" />
</BaseLayout>

<style>
  /* No inline padding: PostBody's own grid owns the gutter, so that a
     full-bleed figure can actually reach the edge of the page. */
  .post-page {
    padding-top: var(--section-gap-sm); /* 80 */
    padding-bottom: var(--section-gap); /* 180 */
  }

  .similar {
    padding-bottom: var(--section-gap); /* 180 */
  }

  .similar__title {
    margin-bottom: var(--sp-80);
    font-size: var(--fs-h2); /* 64 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-ink);
  }

  /* #85:159 sets 80 between the rows, where the listing's own #237:867 sets
     none and lets each row's rule do the separating. Two rows read as a pair
     rather than a list, so the design gives them room. */
  .similar__list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-80);
  }

  @media (max-width: 992px) {
    .similar__title {
      margin-bottom: var(--section-gap-sm);
    }

    .similar__list {
      gap: var(--section-gap-sm);
    }
  }
</style>

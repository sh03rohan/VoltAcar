---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import MissionStatement from '../components/sections/MissionStatement.astro';
import KidsSafety from '../components/sections/KidsSafety.astro';
import QuoteBand from '../components/sections/QuoteBand.astro';
import FeatureRow from '../components/sections/FeatureRow.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import MeetTheTeam from '../components/sections/MeetTheTeam.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { site } from '../config/site';

import aboutHero from '../assets/images/about-hero.webp';
import visionImg from '../assets/images/vision.webp';
import missionImg from '../assets/images/mission.webp';
import aboutCta from '../assets/images/about-cta.webp';
---

<BaseLayout
  title={`About us | ${site.name}`}
  description="How VoltACar is redefining electric mobility — innovative, sustainable, and designed for every journey."
>
  <Header slot="header" />

  {/* Figma #87:206. The frame stacks a landscape plate and a car render over
      #131400; both are flattened into one asset at their exact offsets, so the
      band is a plain 1600x780 image and the scrim stays a responsive CSS layer.

      Radius measured off the exported scrim node (#96:127) — the MCP reports
      radial fills without one, and farthest-corner would put it at 1386px
      against a true 848 x 555. */}
  <PageHero
    title="About VoltACar and Our Mission"
    body="Discover how we’re redefining electric mobility — innovative, sustainable, and designed for every journey."
    image={aboutHero}
    scrim="radial-gradient(53% 71.15% at 68.75% 59.17%, rgba(19,20,0,0.2) 0%, rgba(19,20,0,0.62) 49%, rgba(19,20,0,0.83) 100%)"
    imageFocus="72% 50%"
    imageFocusNarrow="100% 50%"
    copyWidth={656}
    bodyWidth={565}
  />

  {/* Figma #87:324 — the same 1162px statement as Features (#126:295), word
      for word. Unlike Features it sits straight on the page cream: the frame
      has no white band here, which the render confirms all the way down to
      the team section. */}
  <MissionStatement statement="We are shaping the next generation of electric mobility — crafted for modern cities, everyday lives, and a cleaner future. Our mission is simple: make electric driving accessible, efficient, and human-centered, from compact designs to advanced technology." />

  {/* Figma #87:355 — heading row plus a six-photo track on ScrollTrack */}
  <KidsSafety />

  {/* Figma #263:1010 — the Home band (#167:176) verbatim: same quote, same
      attribution, same background fill. Nothing to vary, so nothing is passed
      that Home does not also pass. */}
  <QuoteBand
    quote="“At VoltACar, we’re rethinking transportation by blending smart technology, sustainability, and human-centered design to make electric driving intuitive and accessible.”"
    attribution="John Sans, Founder & CEO"
  />

  {/* Figma #129:442 — the two Features rows (#129:444/#129:450) with this
      page's copy. Same 1400 row, same 565x700 card, same 151 gap. Unlike
      Features the body is held to 565 rather than filling the 684 column, and
      the two rows sit 80 apart rather than 180. */}
  <div class="about-purpose">
    {/* Figma #99:158 */}
    <FeatureRow
      title="Our Vision"
      body="To create a world where sustainable, intelligent, and accessible electric mobility transforms everyday journeys, making cities cleaner, driving safer, and innovation a part of every ride."
      image={visionImg}
      imageAlt="A VoltACar lit from above in a clean studio setting"
      mediaSide="right"
      bodyWidth={565}
    />

    {/* Figma #99:159 */}
    <FeatureRow
      title="Our Mission"
      body="To deliver innovative, safe, and sustainable electric vehicles that make everyday driving efficient, enjoyable, and accessible for everyone."
      image={missionImg}
      imageAlt="A VoltACar parked in calm natural surroundings"
      mediaSide="left"
      bodyWidth={565}
    />
  </div>

  {/* Figma #148:769 — a standalone band, not a slider: this page carries one
      card and the frame has no variants beside it. Copy sits at the foot of
      the 807x620 block, which is the `foot` align CtaBanner already has.

      Radius measured off the exported scrim node (#148:771) — 802 x 692
      against the ~1300 CSS would have assumed. */}
  <CtaBanner
    layout="band"
    align="foot"
    title="Engineered for "
    titleAccent="Modern Life, Fueled"
    titleTrail=" by Innovation"
    body="Shaping a cleaner, safer, and smarter future through innovative electric mobility for every journey."
    image={aboutCta}
    alt="A VoltACar seen from the rear three-quarter against a dark backdrop"
    scrim="radial-gradient(50.13% 88.74% at 93.83% 73.94%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.34) 58%, rgba(19,20,0,0.59) 100%)"
    titleWidth={807}
    bodyWidth={445}
  />

  {/* Figma #103:189 — white band, six lime cards, detail on hover/focus */}
  <MeetTheTeam />

  {/* Figma #91:572 */}
  <Newsletter />

  {/* Figma #91:594 */}
  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Figma #129:442: 180 of cream above the pair, then only 80 between the two
     rows and 80 below — a tighter rhythm than the 180 the page uses elsewhere,
     which is what groups them as one statement. */
  .about-purpose {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap-sm);
    margin-block: var(--section-gap) var(--section-gap-sm);
  }
</style>

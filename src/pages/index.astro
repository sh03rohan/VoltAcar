---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import { site } from '../config/site';
---

<BaseLayout title={site.name} description={site.description}>
  <Header slot="header" />

  <Hero />
  <MissionBand />

  {/* Remaining Home sections follow in Sub-phase 4 onward. */}
  <section class="filler">
    <div class="container">
      <p>Next: the alternating feature blocks.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .filler {
    display: grid;
    place-items: center;
    min-height: 60vh;
    color: var(--c-text-soft);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import MissionBand from '../components/sections/MissionBand.astro';
import AlternatingBlock from '../components/sections/AlternatingBlock.astro';
import CarHotspots from '../components/sections/CarHotspots.astro';
import QuoteBand from '../components/sections/QuoteBand.astro';
import InteriorFeatures from '../components/sections/InteriorFeatures.astro';
import CtaSlider, { type CtaCard } from '../components/sections/CtaSlider.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import { site } from '../config/site';

import featureAutonomous from '../assets/images/feature-autonomous.webp';
import featureCharging from '../assets/images/feature-charging.webp';
import featureRange from '../assets/images/feature-range.webp';
import ctaRemote from '../assets/images/cta-remote.webp';
import ctaHomeImg from '../assets/images/cta-home.webp';
import ctaRoadside from '../assets/images/cta-roadside.webp';

/* Figma cards "1" (#37:40), "2" (#55:139) and "3" (#55:91). */
const ctaCards: CtaCard[] = [
  {
    title: 'Power Up',
    breakAfterTitle: true,
    titleAccent: 'Anywhere, Anytime',
    body: 'Even in remote locations like hills or scenic spots, our network keeps your car charged and ready.',
    image: ctaRemote,
    alt: 'A VoltACar charging at a station on a mountain ridge',
    scrim:
      'radial-gradient(circle at 85% 79%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.34) 78%, rgba(19,20,0,0.59) 100%)',
  },
  {
    title: 'Charge',
    breakAfterTitle: true,
    titleAccent: 'Comfortably at Home',
    body: 'Plug in overnight and wake up to a full battery, ready for a day of driving.',
    image: ctaHomeImg,
    alt: 'A VoltACar charging on a driveway beside a home wallbox',
    scrim:
      'radial-gradient(circle at 101% 100%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.39) 69%, rgba(19,20,0,0.78) 100%)',
  },
  {
    title: 'Fast',
    breakAfterTitle: true,
    titleAccent: 'Charging on the Go',
    body: 'Convenient roadside stations let you recharge quickly, keeping your journey smooth and uninterrupted.',
    image: ctaRoadside,
    alt: 'A VoltACar at a roadside charging point in a city square',
    scrim:
      'radial-gradient(circle at 101% 98%, rgba(19,20,0,0) 0%, rgba(19,20,0,0.39) 51%, rgba(19,20,0,0.78) 100%)',
  },
];
---

<BaseLayout title={site.name} description={site.description}>
  <Header slot="header" />

  <Hero />
  <MissionBand />

  {/* Figma #25:254 — media 758, gap 177 of the 1500 row */}
  <AlternatingBlock
    title="Engineered for Modern Life, "
    titleAccent="Fueled by Innovation"
    body="Experience a safer, smarter ride with advanced autonomous driving technology that adapts seamlessly to traffic and road conditions."
    image={featureAutonomous}
    imageAlt="Overhead view of the VoltACar cabin and panoramic roof"
    mediaSide="left"
    mediaWidth="50.5333%"
    columnGap="11.8%"
  />

  {/* Figma #25:213 — media 821, gap 114 of the 1500 row */}
  <AlternatingBlock
    title="Ready in Minutes, "
    titleAccent="Driven by Technology"
    body="Get back on the road quickly with advanced fast-charging technology that reaches 80% in just 30 minutes."
    image={featureCharging}
    imageAlt="Front view of the VoltACar showing its lighting signature"
    mediaSide="right"
    mediaWidth="54.7333%"
    columnGap="7.6%"
    titleWidth={503}
    bodyWidth={451}
  />

  {/* Figma #22:166 — media 794, gap 141 of the 1500 row */}
  <AlternatingBlock
    title="Built for Every Journey, "
    titleAccent="Energized by Technology"
    body="Travel farther with confidence. Thanks to a high-capacity electric battery that delivers up to 500 km per charge."
    image={featureRange}
    imageAlt="Top-down view of the VoltACar interior and seating"
    mediaSide="left"
    mediaWidth="52.9333%"
    columnGap="9.4%"
    titleWidth={525}
    bodyWidth={444}
  />

  <CarHotspots />

  {/* Figma #167:176 */}
  <QuoteBand
    quote="“At VoltACar, we’re rethinking transportation by blending smart technology, sustainability, and human-centered design to make electric driving intuitive and accessible.”"
    attribution="John Sans, Founder & CEO"
  />

  {/* Figma #59:207 */}
  <InteriorFeatures />

  {/* Figma cards #37:40, #55:139, #55:91 — pinned horizontal slider */}
  <CtaSlider cards={ctaCards} />

  {/* Figma #91:572 — shared with every other content page */}
  <Newsletter />

  {/* Figma #91:594 */}
  <Footer slot="footer" />
</BaseLayout>

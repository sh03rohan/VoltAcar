---
/**
 * A radio group laid out in the frame's two columns — Figma `#118:568` and
 * `#120:165`, options from the component set `118:288`.
 *
 *   block    padding 16 0, gap 16
 *   legend   24 / 600, ink
 *   content  two columns, 32 apart, 14 between rows
 *   control  18x18, 1px, fully round; selected fills ink with an 8px white eye
 *   label    16 / 500, ink
 *
 * The frame fills its columns top to bottom — 1,2,3 then 4,5,6 — so the grid
 * is column-major with its row count derived from the option list rather than
 * hard-coded, which is what lets the group take any number of options.
 */
interface Props {
  legend: string;
  name: string;
  options: string[];
  /** Preselects one option, matched by value. */
  value?: string;
  required?: boolean;
  /**
   * The time group's first column is a fixed 206 (#120:168) where the
   * location group's two share the width. Short labels, held together rather
   * than thrown to the edges of a 922 form.
   */
  tight?: boolean;
}

const { legend, name, options, value, required = false, tight = false } = Astro.props;

const rows = Math.ceil(options.length / 2);
const legendId = `legend-${name}`;
---

{/* A real <legend> is laid out against the fieldset's *border* edge and
    ignores its padding — measured at offsetTop 0 against a stated 16 — so the
    group's top space would silently vanish. `aria-labelledby` names the
    fieldset just as well and leaves the label an ordinary block. */}
<fieldset class="radios" aria-labelledby={legendId} data-radio-group>
  <p class="radios__legend" id={legendId}>{legend}</p>

  <div class:list={['radios__grid', tight && 'radios__grid--tight']} style={`--rows:${rows}`}>
    {
      options.map((option, i) => (
        <label class="radio">
          <input
            class="radio__input"
            type="radio"
            name={name}
            value={option}
            checked={value === option}
            required={required && i === 0}
          />
          <span class="radio__control" aria-hidden="true" />
          <span class="radio__label">{option}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  /* A fieldset carries UA borders and padding that no reset removes. */
  .radios {
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
    min-width: 0;
    margin: 0;
    padding: var(--sp-16) 0;
    border: 0;
  }

  .radios__legend {
    padding: 0;
    font-size: var(--fs-h6); /* 24 */
    font-weight: var(--fw-semibold);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  /* Column-major, so the options read down one column and then down the next
     exactly as the frame draws them. */
  .radios__grid {
    display: grid;
    grid-template-rows: repeat(var(--rows), auto);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: var(--sp-14) var(--sp-32);
  }

  .radios__grid--tight {
    grid-template-columns: 12.875rem minmax(0, 1fr); /* 206 */
  }

  /* Aligned to the first line rather than the label's middle. On the one-line
     labels the frame draws, (24 - 18) / 2 is the same 3px `center` would give;
     once an address wraps to two lines it is the difference between a dot
     beside the text and a dot floating between the lines. */
  .radio {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-12);
    cursor: pointer;
  }

  .radio__control {
    margin-top: 3px;
  }

  /* Kept in the layout rather than `display: none`, so it stays focusable and
     the control below can follow its state. */
  .radio__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .radio__control {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    border: 1px solid var(--c-muted);
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  /* Figma #I118:572;4797:135 — an 8px white eye at (5,5) of the 18px dot,
     which is the ink circle showing through rather than a coloured centre. */
  .radio__control::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    transform: translate(-50%, -50%) scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .radio__input:checked + .radio__control {
    border-color: var(--c-ink);
    background-color: var(--c-ink);
  }

  .radio__input:checked + .radio__control::after {
    transform: translate(-50%, -50%) scale(1);
  }

  .radio__input:focus-visible + .radio__control {
    outline: 2px solid var(--c-ink);
    outline-offset: 2px;
  }

  .radio:hover .radio__input:not(:checked) + .radio__control {
    border-color: var(--c-ink);
  }

  .radio__label {
    font-size: var(--fs-body); /* 16 */
    font-weight: var(--fw-medium);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  /* Two columns of six-word postal addresses stop working long before the
     form does; one column keeps each option on a single line further down. */
  @media (max-width: 768px) {
    .radios__grid,
    .radios__grid--tight {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-flow: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radio__control,
    .radio__control::after {
      transition: none;
    }
  }
</style>

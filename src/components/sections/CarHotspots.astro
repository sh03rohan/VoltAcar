---
import { Image } from 'astro:assets';
import Icon from '../common/Icon.astro';
import { features, views } from '../../data/hotspots';

/**
 * The car explorer — Figma #48:60, extended to the client's reference for an
 * interactive viewer.
 *
 * A white panel holding a stage, a row of viewpoint tabs and a strip of
 * thumbnails. Markers sit on the render; clicking one opens a feature card
 * beside the car.
 *
 * WHAT THIS IS NOT
 *
 * It is not WebGL and it is not a turntable. This project has no 3D model and
 * no evenly-spaced rotation sequence — its renders are four separate studio
 * photographs. So dragging steps between viewpoints rather than spinning the
 * car, and the hint says so rather than promising a rotation that cannot
 * happen. Everything else in the reference is here.
 *
 * Give `views` in the data file 36 evenly-spaced renders and the drag becomes
 * a real 360 with no change to this file; point it at a WebGL camera that
 * reports projected marker positions and the same holds.
 *
 * MARKER PLACEMENT
 *
 * The stage is a fixed box and every render has its own aspect ratio, so each
 * image is `contain`ed and letterboxed inside it. Marker coordinates are
 * percentages of the *rendered image*, and the script measures that box and
 * maps them onto it. Treating them as percentages of the stage would put
 * every marker on the interior view somewhere else entirely.
 *
 * Panels are rendered server-side and hidden: the right one is a matter of
 * which panel is shown rather than of copying strings around, each image stays
 * an optimised Astro asset, and a hidden image is not fetched until shown.
 */
const panelId = (id: string): string => `car-feature-${id}`;

const titleFor = (id: string): string => features.find((f) => f.id === id)?.title ?? id;
---

<section class="explorer" data-explorer aria-labelledby="explorer-title">
  <div class="explorer__panel">
    {/* ---------- Header ---------- */}
    <div class="explorer__head">
      <div class="explorer__hint">
        <p class="explorer__eyebrow">Multi-view</p>
        <div class="explorer__hint-row">
          <span class="explorer__hint-icon" aria-hidden="true"><Icon name="drag" size={20} /></span>
          <span class="explorer__hint-text">
            Drag or swipe to change view<br />Pick a hotspot for detail
          </span>
        </div>
      </div>

      <div class="explorer__titles">
        <h2 class="explorer__title" id="explorer-title">Explore Every Detail</h2>
        <p class="explorer__sub">
          Interact with the hotspots and discover the features that make VoltACar exceptional.
        </p>
      </div>

      <button class="explorer__reset" type="button" data-reset>
        <Icon name="reset" size={18} />
        Reset View
      </button>
    </div>

    {/* ---------- Body ---------- */}
    <div class="explorer__body">
      <div class="stage">
        <div class="stage__viewport" data-viewport role="group" aria-label="Car viewer">
          <span class="stage__ground" data-ground aria-hidden="true"></span>

          {
            views.map((view, i) => (
              <Image
                class="stage__image"
                src={view.image}
                alt={view.imageAlt}
                widths={[640, 900, 1280]}
                sizes="(max-width: 1100px) 92vw, 900px"
                data-view-image={i}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                hidden={i !== 0}
              />
            ))
          }

          {
            views.map((view, vi) =>
              view.hotspots.map((h, hi) => (
                <button
                  type="button"
                  class="pin"
                  data-pin
                  data-view={vi}
                  data-feature={h.feature}
                  data-x={h.x}
                  data-y={h.y}
                  aria-expanded="false"
                  aria-controls={panelId(h.feature)}
                  hidden={vi !== 0}
                  style={`--pin-delay:${hi * 0.4}s`}
                >
                  <span class="visually-hidden">{titleFor(h.feature)}</span>
                  <span class="pin__core">
                    <Icon name="plus" size={20} />
                  </span>
                </button>
              )),
            )
          }
        </div>

        <p class="stage__dial" aria-hidden="true"><span>360°</span></p>
      </div>

      {/* ---------- Feature card ---------- */}
      <aside class="card" data-card hidden aria-label="Feature detail">
        <button class="card__close" type="button" data-card-close>
          <Icon name="close" size={16} />
          <span class="visually-hidden">Close feature detail</span>
        </button>

        {
          features.map((f) => (
            <article class="card__panel" id={panelId(f.id)} data-card-panel={f.id} hidden>
              <div class="card__media">
                <Image
                  src={f.image}
                  alt={f.imageAlt}
                  widths={[320, 520, 760]}
                  sizes="(max-width: 1100px) 92vw, 300px"
                  loading="lazy"
                  decoding="async"
                  class="card__image"
                />
              </div>

              <p class="card__category">{f.category}</p>
              <h3 class="card__title">{f.title}</h3>
              <p class="card__desc">{f.description}</p>

              {f.features && f.features.length > 0 && (
                <ul class="card__list" role="list">
                  {f.features.map((item) => (
                    <li>
                      <span class="card__tick" aria-hidden="true">
                        <Icon name="check" size={14} />
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>
              )}

              {f.learnMore && (
                <a class="card__cta" href={f.learnMore.href}>
                  {f.learnMore.label}
                  <Icon name="chevron" size={18} />
                </a>
              )}
            </article>
          ))
        }
      </aside>
    </div>

    {/* ---------- View tabs ---------- */}
    <div class="tabs" role="tablist" aria-label="Viewpoint">
      {
        views.map((view, i) => (
          <button
            class="tabs__tab"
            type="button"
            role="tab"
            data-tab={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {view.label}
          </button>
        ))
      }
    </div>

    {/* ---------- Thumbnails ---------- */}
    <div class="thumbs">
      <button class="thumbs__arrow thumbs__arrow--prev" type="button" data-thumb-prev disabled>
        <Icon name="chevron" size={18} />
        <span class="visually-hidden">Previous view</span>
      </button>

      <ul class="thumbs__list" data-thumb-list role="list">
        {
          views.map((view, i) => (
            <li>
              <button
                class="thumbs__item"
                type="button"
                data-thumb={i}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <Image
                  src={view.image}
                  alt=""
                  widths={[160, 320]}
                  sizes="160px"
                  loading="lazy"
                  decoding="async"
                />
                <span class="visually-hidden">{view.label}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <button class="thumbs__arrow thumbs__arrow--next" type="button" data-thumb-next>
        <Icon name="chevron" size={18} />
        <span class="visually-hidden">Next view</span>
      </button>
    </div>
  </div>
</section>

<style>
  .explorer {
    padding-block: var(--section-gap-sm);
    padding-inline: var(--gutter);
    background-color: var(--c-cream);
  }

  /* The renders are studio shots on white, so the viewer sits on white — as
     the reference does, a rounded panel holding the whole experience. */
  .explorer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-24);
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--sp-32);
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-lg);
    background-color: var(--c-white);
  }

  /* ---------- Header ---------- */

  .explorer__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: var(--sp-24);
  }

  .explorer__eyebrow {
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-steel-text);
  }

  .explorer__hint-row {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
    margin-top: var(--sp-8);
  }

  .explorer__hint-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-pill);
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  .explorer__hint-text {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--c-muted);
  }

  .explorer__titles {
    text-align: center;
  }

  .explorer__title {
    font-size: var(--fs-h3); /* 52 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-ink);
  }

  .explorer__sub {
    max-width: 30rem;
    margin: var(--sp-12) auto 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .explorer__reset {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    height: 2.75rem;
    padding-inline: var(--sp-20);
    border: 1px solid rgba(19, 20, 0, 0.14);
    border-radius: var(--r-pill);
    background: none;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--c-ink);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .explorer__reset:hover,
  .explorer__reset:focus-visible {
    border-color: var(--c-ink);
    background-color: var(--c-cream);
  }

  /* ---------- Body ---------- */

  .explorer__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    align-items: center;
    gap: var(--sp-32);
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .stage__viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    /* Vertical panning still belongs to the page; horizontal is the drag. */
    touch-action: pan-y;
    cursor: grab;
    transition: transform 420ms var(--ease-out);
  }

  .stage__viewport:active {
    cursor: grabbing;
  }

  /* The dashed ground ring from the reference — a plate for the car to stand
     on, and the only thing suggesting the axis it would turn about. */
  .stage__ground[hidden] {
    display: none;
  }

  .stage__ground {
    position: absolute;
    left: 50%;
    bottom: 7%;
    width: 72%;
    aspect-ratio: 3 / 1;
    border: 1px dashed rgba(19, 20, 0, 0.16);
    border-radius: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .stage__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .stage__image[hidden] {
    display: none;
  }

  .stage__dial {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--c-steel-text);
  }

  .stage__dial::before,
  .stage__dial::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background-color: rgba(19, 20, 0, 0.14);
  }

  /* ---------- Markers ---------- */

  .pin {
    position: absolute;
    /* Placed by the script against the rendered image box. */
    left: 0;
    top: 0;
    width: 2.875rem;
    height: 2.875rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background-color: rgba(255, 255, 255, 0.62);
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    transform: translate(-50%, -50%);
    transition:
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
    animation: pin-glow 3.2s var(--ease-in-out) infinite;
    animation-delay: var(--pin-delay, 0s);
  }

  .pin[hidden] {
    display: none;
  }

  @keyframes pin-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(19, 20, 0, 0.14),
        0 0 12px 2px rgba(19, 20, 0, 0.06);
    }
    50% {
      box-shadow:
        0 0 0 9px rgba(19, 20, 0, 0),
        0 0 22px 7px rgba(19, 20, 0, 0.1);
    }
  }

  /* `animation: none` rather than paused — a running animation outranks a
     plain box-shadow declaration and the held state would never show. */
  .pin:hover,
  .pin:focus-visible {
    animation: none;
    background-color: rgba(255, 255, 255, 0.92);
    box-shadow:
      0 0 0 6px rgba(19, 20, 0, 0.06),
      0 0 24px 6px rgba(19, 20, 0, 0.12);
  }

  .pin[aria-expanded='true'] {
    animation: none;
    background-color: rgba(243, 254, 100, 0.55);
    box-shadow:
      0 0 0 8px rgba(243, 254, 100, 0.32),
      0 0 26px 8px rgba(19, 20, 0, 0.14);
  }

  .pin__core {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    background-color: var(--c-ink);
    border-radius: 50%;
    color: var(--c-primary);
    transition: transform var(--dur) var(--ease-out);
  }

  /* Icon.astro renders the <svg>, so it carries that component's scope and a
     plain descendant rule here would never match it. */
  .pin__core :global(svg) {
    width: 62%;
    height: 62%;
  }

  .pin[aria-expanded='true'] .pin__core {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .pin,
    .pin__core,
    .stage__viewport {
      animation: none;
      transition: none;
    }
  }

  /* ---------- Feature card ---------- */

  .card {
    position: relative;
    align-self: center;
    padding: var(--sp-16);
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-md);
    background-color: var(--c-white);
    box-shadow: var(--shadow-lg);
  }

  .card[hidden],
  .card__panel[hidden] {
    display: none;
  }

  .card__close {
    position: absolute;
    top: var(--sp-24);
    right: var(--sp-24);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background-color: rgba(19, 20, 0, 0.55);
    color: var(--c-cream);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .card__close:hover,
  .card__close:focus-visible {
    background-color: var(--c-ink);
    transform: scale(1.08);
  }

  .card__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-sm);
    background-color: var(--c-cream);
    overflow: hidden;
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__category {
    margin-top: var(--sp-16);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-steel-text);
  }

  .card__title {
    margin-top: var(--sp-8);
    font-size: var(--fs-h6); /* 24 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--c-ink);
  }

  .card__desc {
    margin-top: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .card__list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    margin-top: var(--sp-20);
  }

  .card__list li {
    display: flex;
    align-items: center;
    gap: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .card__tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--r-pill);
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  .card__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-12);
    margin-top: var(--sp-20);
    padding: var(--sp-12) var(--sp-20);
    border-radius: var(--r-sm);
    background-color: var(--c-ink);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--c-primary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .card__cta:hover,
  .card__cta:focus-visible {
    background-color: #23240a;
  }

  /* ---------- Tabs ---------- */

  .tabs {
    display: flex;
    justify-content: center;
    gap: var(--sp-2);
    align-self: center;
    max-width: 100%;
    padding: var(--sp-8);
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    box-shadow: var(--shadow-lg);
  }

  .tabs__tab {
    padding: var(--sp-8) var(--sp-20);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--c-muted);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .tabs__tab:hover {
    color: var(--c-ink);
  }

  .tabs__tab[aria-selected='true'] {
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  /* ---------- Thumbnails ---------- */

  .thumbs {
    display: flex;
    align-items: center;
    gap: var(--sp-12);
  }

  .thumbs__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(19, 20, 0, 0.12);
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    color: var(--c-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .thumbs__arrow:hover:not(:disabled),
  .thumbs__arrow:focus-visible {
    border-color: var(--c-ink);
    background-color: var(--c-cream);
  }

  .thumbs__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .thumbs__arrow--prev :global(svg) {
    transform: rotate(90deg);
  }

  .thumbs__arrow--next :global(svg) {
    transform: rotate(-90deg);
  }

  .thumbs__list {
    display: flex;
    flex: 1 1 auto;
    gap: var(--sp-12);
    margin: 0;
    padding: 0;
    list-style: none;
    /* Centred only while the strip fits. `justify-content: center` on an
       overflowing scroll container pushes the first item past the start edge
       and no amount of scrolling brings it back — `width: fit-content` with
       auto margins centres when there is room and starts at the left when
       there is not. */
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .thumbs__list::-webkit-scrollbar {
    display: none;
  }

  .thumbs__list > li {
    flex: 1 1 8.5rem;
    max-width: 15rem;
    scroll-snap-align: start;
  }

  .thumbs__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--r-sm);
    background-color: var(--c-cream);
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  /* An explicit height, not `aspect-ratio`. These are raw <img> tags carrying
     their intrinsic width/height attributes, and the global reset sets
     `max-width: 100%` without the usual `height: auto` — so the used height
     stays the attribute's (1615px here) and `aspect-ratio` never applies,
     because it only governs a dimension that is `auto`. Stating the height
     settles it without reaching into the reset. */
  .thumbs__item img {
    display: block;
    width: 100%;
    height: 6.5rem;
    object-fit: contain;
  }

  .thumbs__item:hover {
    border-color: rgba(19, 20, 0, 0.2);
  }

  .thumbs__item[aria-current='true'] {
    border-color: var(--c-primary);
  }

  /* ---------- Responsive ---------- */

  /* The card cannot sit beside the car much below the container, so it drops
     under it and the stage takes the full width. */
  @media (max-width: 1100px) {
    .explorer__panel {
      padding: var(--sp-24) var(--sp-20);
    }

    .explorer__head {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
    }

    /* Title, then how to use it, then the escape hatch. */
    .explorer__hint {
      order: 1;
    }

    .explorer__reset {
      order: 2;
      justify-self: center;
    }

    .explorer__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .card {
      justify-self: center;
      width: 100%;
      max-width: 32rem;
    }
  }

  @media (max-width: 700px) {
    .explorer {
      padding-block: var(--section-gap);
    }

    .explorer__panel {
      padding: var(--sp-20) var(--sp-16);
    }

    .explorer__title {
      font-size: var(--fs-h4);
    }

    .stage__viewport {
      aspect-ratio: 4 / 3;
    }

    /* Wrapping beats a squeezed row; the thumbnails below do the same job
       with pictures. */
    .tabs {
      flex-wrap: wrap;
      justify-content: center;
      border-radius: var(--r-lg);
    }

    .thumbs__list > li {
      flex: 0 0 6.5rem;
    }

    .thumbs__arrow {
      display: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';
  import { views } from '../../data/hotspots';

  const section = document.querySelector<HTMLElement>('[data-explorer]');

  if (section) {
    const viewport = section.querySelector<HTMLElement>('[data-viewport]');
    const card = section.querySelector<HTMLElement>('[data-card]');

    if (viewport && card) {
      const images = Array.from(section.querySelectorAll<HTMLImageElement>('[data-view-image]'));
      const pins = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-pin]'));
      const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const thumbs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-thumb-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-thumb-next]');
      const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-card-panel]'));
      const closeBtn = section.querySelector<HTMLButtonElement>('[data-card-close]');
      const ground = section.querySelector<HTMLElement>('[data-ground]');
      const resetBtn = section.querySelector<HTMLButtonElement>('[data-reset]');

      const reduce = (): boolean => prefersReducedMotion();

      let view = 0;
      let openFeature: string | null = null;
      let zoom = 1;

      /* ---------- Marker placement ----------
         The image is `contain`ed, so it does not fill the stage. Markers are
         percentages of the *image*, so the letterboxed box has to be derived
         before they can be placed — otherwise every marker on a view whose
         aspect ratio differs from the stage lands somewhere else. */
      const placePins = (): void => {
        const img = images[view];
        if (!img) return;
        const box = viewport.getBoundingClientRect();
        const nw = img.naturalWidth || img.width;
        const nh = img.naturalHeight || img.height;
        if (!nw || !nh || !box.width) return;

        const scale = Math.min(box.width / nw, box.height / nh);
        const w = nw * scale;
        const h = nh * scale;
        const left = (box.width - w) / 2;
        const top = (box.height - h) / 2;

        pins.forEach((pin) => {
          if (Number(pin.dataset.view) !== view) return;
          pin.style.left = `${left + (Number(pin.dataset.x) / 100) * w}px`;
          pin.style.top = `${top + (Number(pin.dataset.y) / 100) * h}px`;
        });
      };

      const showPanel = (id: string | null): void => {
        panels.forEach((p) => (p.hidden = p.dataset.cardPanel !== id));
      };

      const syncPins = (): void => {
        pins.forEach((pin) => {
          const mine = Number(pin.dataset.view) === view;
          pin.hidden = !mine;
          pin.setAttribute('aria-expanded', String(mine && pin.dataset.feature === openFeature));
        });
        placePins();
      };

      /* ---------- Card ---------- */

      const openCard = (id: string): void => {
        const first = openFeature === null;
        const previous = openFeature;
        openFeature = id;
        syncPins();
        card.hidden = false;

        const panel = panels.find((p) => p.dataset.cardPanel === id);
        if (!panel) return;

        if (reduce()) {
          showPanel(id);
          gsap.set(card, { clearProps: 'all' });
          return;
        }

        if (first) {
          showPanel(id);
          gsap.fromTo(
            card,
            { x: 36, opacity: 0, scale: 0.98 },
            { x: 0, opacity: 1, scale: 1, duration: 0.5, ease: 'power3.out' },
          );
          gsap.fromTo(
            panel,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.36, ease: 'power2.out', delay: 0.1, clearProps: 'all' },
          );
        } else if (previous !== id) {
          /* Already open on another subject: the frame holds still and only
             its contents change. Closing and reopening reads as a glitch. */
          const outgoing = panels.find((p) => !p.hidden);
          const tl = gsap.timeline();
          if (outgoing) tl.to(outgoing, { opacity: 0, x: -16, duration: 0.16, ease: 'power2.in' });
          tl.add(() => showPanel(id));
          tl.fromTo(
            panel,
            { opacity: 0, x: 22 },
            { opacity: 1, x: 0, duration: 0.32, ease: 'power3.out', clearProps: 'all' },
          );
          if (outgoing) tl.set(outgoing, { clearProps: 'all' });
        }
      };

      const closeCard = (): void => {
        if (openFeature === null) return;
        openFeature = null;
        syncPins();

        const finish = (): void => {
          card.hidden = true;
          showPanel(null);
          gsap.set(card, { clearProps: 'all' });
        };

        if (reduce()) {
          finish();
          return;
        }
        gsap.to(card, {
          x: 28,
          opacity: 0,
          scale: 0.98,
          duration: 0.28,
          ease: 'power2.in',
          onComplete: finish,
        });
      };

      /* ---------- Views ---------- */

      const setView = (next: number, animate = true): void => {
        const clamped = Math.max(0, Math.min(views.length - 1, next));
        if (clamped === view) return;
        view = clamped;

        images.forEach((img, i) => (img.hidden = i !== view));
        if (ground) ground.hidden = views[view].ground === false;
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === view));
          tab.tabIndex = i === view ? 0 : -1;
        });
        thumbs.forEach((thumb, i) => {
          if (i === view) thumb.setAttribute('aria-current', 'true');
          else thumb.removeAttribute('aria-current');
        });
        if (prevBtn) prevBtn.disabled = view === 0;
        if (nextBtn) nextBtn.disabled = view === views.length - 1;

        /* A subject can appear on several views; if it is not on this one the
           card would be describing something no longer on screen. */
        if (openFeature && !views[view].hotspots.some((h) => h.feature === openFeature)) {
          closeCard();
        }
        syncPins();

        thumbs[view]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });

        if (animate && !reduce()) {
          gsap.fromTo(images[view], { opacity: 0.35 }, { opacity: 1, duration: 0.32, ease: 'power2.out' });
        }
      };

      /* ---------- Zoom ---------- */

      const applyZoom = (): void => {
        viewport.style.transform = zoom === 1 ? '' : `scale(${zoom})`;
        placePins();
      };

      const setZoom = (next: number): void => {
        zoom = Math.max(1, Math.min(2.2, Number(next.toFixed(3))));
        applyZoom();
      };

      /* Only with a modifier — which is exactly what a trackpad pinch sends.
         Taking the plain wheel would trap the page scroll over a section this
         tall and the visitor could not get past it. */
      viewport.addEventListener(
        'wheel',
        (event) => {
          if (!event.ctrlKey && !event.metaKey) return;
          event.preventDefault();
          setZoom(zoom - event.deltaY * 0.002);
        },
        { passive: false },
      );

      /* ---------- Drag / swipe ---------- */

      let dragging = false;
      let startX = 0;
      let stepped = 0;
      const STEP = 90; // px of travel per viewpoint

      viewport.addEventListener('pointerdown', (event) => {
        if ((event.target as HTMLElement).closest('[data-pin]')) return;
        dragging = true;
        startX = event.clientX;
        stepped = 0;
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const steps = Math.trunc((event.clientX - startX) / STEP);
        if (steps === stepped) return;
        setView(view + (steps > stepped ? 1 : -1));
        stepped = steps;
      });

      const endDrag = (event: PointerEvent): void => {
        if (!dragging) return;
        dragging = false;
        if (viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      /* ---------- Wiring ---------- */

      pins.forEach((pin) => {
        pin.addEventListener('click', () => {
          const id = pin.dataset.feature;
          if (!id) return;
          if (id === openFeature) closeCard();
          else openCard(id);
        });
      });

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => setView(i));
        tab.addEventListener('keydown', (event) => {
          const key = event.key;
          if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
          event.preventDefault();
          const next = (i + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          setView(next);
          tabs[next]?.focus();
        });
      });

      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => setView(i)));
      prevBtn?.addEventListener('click', () => setView(view - 1));
      nextBtn?.addEventListener('click', () => setView(view + 1));
      closeBtn?.addEventListener('click', closeCard);

      resetBtn?.addEventListener('click', () => {
        closeCard();
        setZoom(1);
        setView(0);
        syncPins();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && openFeature !== null) closeCard();
      });

      /* ---------- Placement lifecycle ----------
         Markers depend on the rendered image box, which depends on the image
         having decoded and on the stage's size. Both are waited for rather
         than assumed. */
      new ResizeObserver(() => placePins()).observe(viewport);

      images.forEach((img) => {
        if (img.complete) return;
        img.addEventListener('load', () => placePins(), { once: true });
      });

      void document.fonts?.ready.then(() => placePins());
      if (ground) ground.hidden = views[0].ground === false;
      syncPins();

      if (!reduce()) {
        gsap.fromTo(
          pins.filter((p) => !p.hidden),
          { scale: 0, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.55,
            ease: 'back.out(1.7)',
            stagger: 0.07,
            /* Handed back to CSS, or the inline transform would beat the
               translate(-50%,-50%) that centres each marker on its point. */
            clearProps: 'transform,opacity',
            scrollTrigger: { trigger: section, start: 'top 75%', once: true },
          },
        );
      }
    }
  }
</script>

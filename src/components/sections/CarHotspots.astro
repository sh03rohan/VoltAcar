---
import { Image } from 'astro:assets';
import Icon from '../common/Icon.astro';
import { features, views } from '../../data/hotspots';

/**
 * The car explorer — Figma #48:60, extended to the client's reference for an
 * interactive viewer.
 *
 * A panel holding a stage, a row of viewpoint tabs and a strip of thumbnails.
 * Markers sit on the render; clicking one opens a feature card beside the car.
 *
 * ONE VIEWPORT
 *
 * The section is sized to the viewport, less the header that pins itself over
 * it, and everything inside is laid out against that budget: fixed rows for
 * the header and the controls, and a stage that takes what is left. The parts
 * that can give are on viewport-relative clamps; the stage absorbs the rest.
 * See the layout notes in the stylesheet — several of them exist because a
 * blanket `height: 100vh` gets three separate things wrong.
 *
 * WHAT THIS IS NOT
 *
 * It is not WebGL and it is not a turntable. This project has no 3D model and
 * no evenly-spaced rotation sequence — its renders are separate studio
 * photographs. So dragging steps between viewpoints rather than spinning the
 * car, and the hint says so rather than promising a rotation that cannot
 * happen.
 *
 * Give `views` in the data file 36 evenly-spaced renders and the drag becomes
 * a real 360 with no change to this file; point it at a WebGL camera that
 * reports projected marker positions and the same holds.
 *
 * MARKER PLACEMENT
 *
 * The stage is a box of whatever height is left and every render has its own
 * aspect ratio, so each image is `contain`ed and letterboxed inside it. Marker
 * coordinates are percentages of the *rendered image*, and the script measures
 * that box and maps them onto it. Treating them as percentages of the stage
 * would put every marker on the interior view somewhere else entirely.
 *
 * Panels are rendered server-side and hidden: the right one is a matter of
 * which panel is shown rather than of copying strings around, each image stays
 * an optimised Astro asset, and a hidden image is not fetched until shown.
 */
const panelId = (id: string): string => `car-feature-${id}`;

const titleFor = (id: string): string => features.find((f) => f.id === id)?.title ?? id;
---

<section class="explorer" data-explorer aria-labelledby="explorer-title">
  <div class="explorer__panel">
    {/* ---------- Header ---------- */}
    <div class="explorer__head">
      <div class="explorer__hint">
        <p class="explorer__eyebrow">Multi-view</p>
        <div class="explorer__hint-row">
          <span class="explorer__hint-icon" aria-hidden="true"><Icon name="drag" size={20} /></span>
          <span class="explorer__hint-text">
            Drag or swipe to change view<br />Pick a hotspot for detail
          </span>
        </div>
      </div>

      <div class="explorer__titles">
        <h2 class="explorer__title" id="explorer-title">Explore Every Detail</h2>
        <p class="explorer__sub">
          Interact with the hotspots and discover the features that make VoltACar exceptional.
        </p>
      </div>

      <button class="explorer__reset" type="button" data-reset>
        <Icon name="reset" size={18} />
        Reset View
      </button>
    </div>

    {/* ---------- Body ---------- */}
    <div class="explorer__body" data-body>
      {/* Drawn between the active marker and the card. Sized to the body by
          the script; `vector-effect` holds the stroke widths however it
          scales.

          Two strokes, not one. The line crosses both the white panel and the
          car's black bodywork, and no single colour survives that: ink
          disappears into the tyres, and anything pale disappears into the
          panel. So a white halo is laid down first and the ink line sits on
          top of it — over the panel the halo is invisible and the ink reads;
          over the paintwork the halo reads and carries the ink with it. */}
      <svg class="connector" data-connector aria-hidden="true">
        <path class="connector__halo" data-connector-path-halo />
        <path class="connector__line" data-connector-path />
        <circle class="connector__dot" data-connector-dot r="3" />
      </svg>

      <div class="stage">
        <div class="stage__viewport" data-viewport role="group" aria-label="Car viewer">
          <span class="stage__ground" data-ground aria-hidden="true"></span>

          {
            views.map((view, i) => (
              <Image
                class="stage__image"
                src={view.image}
                alt={view.imageAlt}
                widths={[640, 900, 1280]}
                sizes="(max-width: 1100px) 92vw, 900px"
                data-view-image={i}
                data-framed={view.framed ? '' : undefined}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                hidden={i !== 0}
              />
            ))
          }

          {
            views.map((view, vi) =>
              view.hotspots.map((h, hi) => (
                <button
                  type="button"
                  class="pin"
                  data-pin
                  data-view={vi}
                  data-feature={h.feature}
                  data-x={h.x}
                  data-y={h.y}
                  aria-expanded="false"
                  aria-controls={panelId(h.feature)}
                  hidden={vi !== 0}
                  style={`--pin-delay:${hi * 0.4}s`}
                >
                  <span class="visually-hidden">{titleFor(h.feature)}</span>
                  <span class="pin__core">
                    <Icon name="plus" size={20} />
                  </span>
                </button>
              )),
            )
          }
        </div>
      </div>

      {/* ---------- Feature card ---------- */}
      <aside class="card" data-card hidden aria-label="Feature detail">
        <button class="card__close" type="button" data-card-close>
          <Icon name="close" size={16} />
          <span class="visually-hidden">Close feature detail</span>
        </button>

        {
          features.map((f) => (
            <article class="card__panel" id={panelId(f.id)} data-card-panel={f.id} hidden>
              <div class="card__media">
                <Image
                  src={f.image}
                  alt={f.imageAlt}
                  widths={[320, 520, 760]}
                  sizes="(max-width: 1100px) 92vw, 300px"
                  loading="lazy"
                  decoding="async"
                  class="card__image"
                />
              </div>

              <p class="card__category">{f.category}</p>
              <h3 class="card__title">{f.title}</h3>
              <p class="card__desc">{f.description}</p>

              {f.features && f.features.length > 0 && (
                <ul class="card__list" role="list">
                  {f.features.map((item) => (
                    <li>
                      <span class="card__tick" aria-hidden="true">
                        <Icon name="check" size={14} />
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>
              )}

              {f.learnMore && (
                <a class="card__cta" href={f.learnMore.href}>
                  {f.learnMore.label}
                  <Icon name="chevron" size={18} />
                </a>
              )}
            </article>
          ))
        }

        {/* The card scrolls with no scrollbar, so something has to say there
            is more below. Last child and sticky, so it rides the foot of the
            scrollport; the script shows it only while there is somewhere left
            to scroll. */}
        <span class="card__fade" data-card-fade aria-hidden="true"></span>
      </aside>
    </div>

    {/* ---------- View tabs ---------- */}
    <div class="tabs" role="tablist" aria-label="Viewpoint">
      {
        views.map((view, i) => (
          <button
            class="tabs__tab"
            type="button"
            role="tab"
            data-tab={i}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {view.label}
          </button>
        ))
      }
    </div>

    {/* ---------- Thumbnails ---------- */}
    <div class="thumbs">
      <button class="thumbs__arrow thumbs__arrow--prev" type="button" data-thumb-prev disabled>
        <Icon name="chevron" size={18} />
        <span class="visually-hidden">Previous view</span>
      </button>

      <ul class="thumbs__list" data-thumb-list role="list">
        {
          views.map((view, i) => (
            <li>
              <button
                class="thumbs__item"
                type="button"
                data-thumb={i}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <Image
                  src={view.image}
                  alt=""
                  widths={[160, 320]}
                  sizes="160px"
                  loading="lazy"
                  decoding="async"
                />
                <span class="visually-hidden">{view.label}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <button class="thumbs__arrow thumbs__arrow--next" type="button" data-thumb-next>
        <Icon name="chevron" size={18} />
        <span class="visually-hidden">Next view</span>
      </button>
    </div>
  </div>
</section>

<style>
  /* ---------- One viewport ----------
     The section is sized to the viewport and everything inside it is laid out
     against that budget: fixed rows for the header and the controls, and the
     stage taking whatever is left. Nothing here is a scaled-down copy of a
     taller layout — the parts that can give (title size, card media, control
     heights) are on viewport-relative clamps, and the stage absorbs the rest.

     `svh` rather than `vh`: on phones `vh` is the *large* viewport, measured
     with the browser's chrome retracted, so a 100vh section is taller than
     what is actually on screen until you scroll. `svh` is the visible box. */
  .explorer {
    display: flex;
    align-items: center;
    padding-block: var(--explorer-pad);
    padding-inline: var(--gutter);
    background-color: var(--c-cream);

    --explorer-pad: clamp(0.75rem, 2.6vh, 2.5rem);
    --explorer-row: clamp(0.625rem, 1.9vh, 1.5rem);
  }

  /* Only claim the viewport where the stacked layout has enough of it to fill.
     Below this, crushing a car, a card and two control rows into a couple of
     hundred pixels is the failure mode a blanket 100vh has — so the section
     flows at its natural height instead. Short *and* wide is the one case
     that can still fit, by turning the layout on its side; that has its own
     rule at the foot of this stylesheet and claims the viewport again. */
  @media (min-height: 640px) {
    .explorer {
      /* Minus the header, which pins itself once the page is past the hero
         and then covers the top of everything. A full 100svh here would be
         exactly `--header-h` taller than what is actually on screen — the
         same mistake `vh` makes on phones, from a different direction. */
      height: calc(100vh - var(--header-h));
      height: calc(100svh - var(--header-h));
    }

    /* The stage stops declaring a shape and takes what is left instead. */
    .stage__viewport {
      aspect-ratio: auto;
    }
  }

  /* The renders are cut out, so the panel is the ground the car stands on. */
  .explorer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--explorer-row);
    width: 100%;
    height: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(var(--sp-16), 2.2vh, var(--sp-32));
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-lg);
    background-color: var(--c-white);
  }

  /* ---------- Header ---------- */

  .explorer__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: var(--sp-24);
  }

  .explorer__eyebrow {
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-steel-text);
  }

  .explorer__hint-row {
    display: flex;
    align-items: center;
    gap: var(--sp-10);
    margin-top: var(--sp-8);
  }

  .explorer__hint-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-pill);
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  .explorer__hint-text {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--c-muted);
  }

  .explorer__titles {
    text-align: center;
  }

  /* Capped at the global H3 and allowed to come down on short viewports, so
     the header gives the stage room rather than the other way round. The token
     is still the ceiling — this narrows the range, it does not redefine it. */
  .explorer__title {
    font-size: min(var(--fs-h3), max(1.5rem, 4.4vh)); /* 52 ceiling */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-ink);
  }

  .explorer__sub {
    max-width: 30rem;
    margin: clamp(0.25rem, 1.1vh, var(--sp-12)) auto 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* What goes first when the viewport is short. The title and the drag hint
     carry the section on their own; below that the hint goes too and the icon
     row's job falls to the tabs, which are unmistakable. */
  @media (max-height: 780px) {
    .explorer__sub {
      display: none;
    }
  }

  @media (max-height: 560px) {
    .explorer__hint {
      display: none;
    }
  }

  .explorer__reset {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-8);
    height: 2.75rem;
    padding-inline: var(--sp-20);
    border: 1px solid rgba(19, 20, 0, 0.14);
    border-radius: var(--r-pill);
    background: none;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--c-ink);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .explorer__reset:hover,
  .explorer__reset:focus-visible {
    border-color: var(--c-ink);
    background-color: var(--c-cream);
  }

  /* ---------- Body ---------- */

  /* The card is positioned against this, not laid out beside the stage: it
     has to sit next to whichever marker was clicked. */
  /* Takes every pixel the fixed rows above and below did not. `min-height: 0`
     is what lets it shrink below its content — without it a flex item floors
     at its content size and the panel overflows the viewport. */
  .explorer__body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .connector {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .connector__halo,
  .connector__line,
  .connector__dot {
    /* Held at the authored width whatever the viewBox scales to. */
    vector-effect: non-scaling-stroke;
  }

  .connector__halo,
  .connector__line {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .connector__halo {
    stroke: var(--c-white);
    stroke-width: 4;
    opacity: 0.75;
  }

  .connector__line {
    stroke: var(--c-ink);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  .connector__dot {
    fill: var(--c-ink);
    stroke: var(--c-white);
    stroke-width: 1.5;
  }


  /* A class, not the `hidden` attribute: `hidden` is an HTMLElement property
     and TypeScript does not type it on SVGSVGElement, so toggling it from
     script would not type-check. */
  .connector {
    display: none;
  }

  .connector.is-on {
    display: block;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    height: 100%;
    transition: padding var(--dur) var(--ease-out);
  }

  /* An anchored card overlays the stage, and on the wide plan view that meant
     it sat on the back half of the car. So the stage gives up the strip the
     card occupies and re-`contain`s the render into what is left: the car
     draws back and to the side as the card comes in, which is the move a
     configurator makes, rather than being covered where it stands.

     Markers follow for free — the resize observer re-runs placement, which
     re-cuts the lead line with it. */
  .explorer__body.has-card .stage {
    padding-inline-end: var(--card-clear, 20.5rem);
  }

  /* A ratio by default, because when the section is *not* claiming the
     viewport nothing else gives the stage a height: the renders are absolutely
     positioned, so the box would collapse to nothing. Inside the viewport-sized
     layout below it is dropped and the leftover height governs instead.

     Either way the markers follow — `placePins()` derives the rendered
     picture's box from its natural size and this one, whatever shape it is. */
  .stage__viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    aspect-ratio: 16 / 10;
    /* Vertical panning still belongs to the page; horizontal is the drag. */
    touch-action: pan-y;
    cursor: grab;
    transition: transform 420ms var(--ease-out);
  }

  .stage__viewport:active {
    cursor: grabbing;
  }

  /* The dashed ground ring from the reference — a plate for the car to stand
     on, and the only thing suggesting the axis it would turn about. */
  .stage__ground[hidden] {
    display: none;
  }

  /* Width, left and bottom are set by the script against the rendered picture;
     these are the pre-placement fallback. */
  .stage__ground {
    position: absolute;
    left: 50%;
    bottom: 7%;
    width: 62%;
    aspect-ratio: 3 / 1;
    border: 1px dashed rgba(19, 20, 0, 0.16);
    border-radius: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .stage__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .stage__image[hidden] {
    display: none;
  }

  /* The cabin shot is a photograph taken from inside the car: there is no
     backdrop around a subject to knock out, so it is framed as a deliberate
     inset rather than left as a bare rectangle beside two cutouts. */
  .stage__image[data-framed] {
    border-radius: var(--r-md);
    /* `contain` letterboxes, and a radius on a letterboxed box rounds the box
       and not the picture. Shrinking to the picture's own footprint is what
       makes the corners land on the photograph. */
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    inset: 0;
    margin: auto;
  }

  /* ---------- Markers ---------- */

  .pin {
    position: absolute;
    /* Placed by the script against the rendered image box. */
    left: 0;
    top: 0;
    width: 2.875rem;
    height: 2.875rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background-color: rgba(255, 255, 255, 0.62);
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;
    transform: translate(-50%, -50%);
    transition:
      box-shadow var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
    animation: pin-glow 3.2s var(--ease-in-out) infinite;
    animation-delay: var(--pin-delay, 0s);
  }

  .pin[hidden] {
    display: none;
  }

  @keyframes pin-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(19, 20, 0, 0.14),
        0 0 12px 2px rgba(19, 20, 0, 0.06);
    }
    50% {
      box-shadow:
        0 0 0 9px rgba(19, 20, 0, 0),
        0 0 22px 7px rgba(19, 20, 0, 0.1);
    }
  }

  /* `animation: none` rather than paused — a running animation outranks a
     plain box-shadow declaration and the held state would never show. */
  .pin:hover,
  .pin:focus-visible {
    animation: none;
    background-color: rgba(255, 255, 255, 0.92);
    box-shadow:
      0 0 0 6px rgba(19, 20, 0, 0.06),
      0 0 24px 6px rgba(19, 20, 0, 0.12);
  }

  .pin[aria-expanded='true'] {
    animation: none;
    background-color: rgba(243, 254, 100, 0.55);
    box-shadow:
      0 0 0 8px rgba(243, 254, 100, 0.32),
      0 0 26px 8px rgba(19, 20, 0, 0.14);
  }

  .pin__core {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    background-color: var(--c-ink);
    border-radius: 50%;
    color: var(--c-primary);
    transition: transform var(--dur) var(--ease-out);
  }

  /* Icon.astro renders the <svg>, so it carries that component's scope and a
     plain descendant rule here would never match it. */
  .pin__core :global(svg) {
    width: 62%;
    height: 62%;
  }

  .pin[aria-expanded='true'] .pin__core {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .pin,
    .pin__core,
    .stage__viewport {
      animation: none;
      transition: none;
    }
  }

  /* ---------- Feature card ---------- */

  /* Placed by the script beside the active marker, on whichever side has
     room. `left`/`top` are set inline. */
  .card {
    /* Read by the script to decide whether to anchor the card to a marker.
       It cannot infer that from `position` any more: the mobile sheet is
       absolutely positioned too, and duplicating the breakpoint in JS is what
       put the two out of step last time. */
    --card-mode: anchored;

    position: absolute;
    z-index: 4;
    width: 19rem;
    /* The body is now only as tall as the viewport allows, so the card takes
       a ceiling and scrolls inside it rather than growing past the panel.
       Minus the inset it is placed at, top and bottom — at a plain 100% the
       card may be exactly as tall as the body, and a card that tall still
       gets positioned 8px down from the top, so it hangs 8px out the
       bottom. Keep this in step with EDGE in the script. */
    max-height: calc(100% - 1rem);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--sp-16);
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    background-color: var(--c-white);

    /* A car and a full spec card do not both fit on a 780px phone, so the
       card scrolls. The bar itself is hidden — it lands over the checklist on
       a card this narrow and is the loudest thing in it — and `.card__fade`
       below carries the cue instead. Hiding it costs no scrolling: touch,
       wheel and keyboard are untouched. */
    scrollbar-width: none;
    /* Moving between two markers is a glide, not a jump. Nothing transitions
       on the first open: the card comes out of `display: none`, and an element
       that was not rendered has no old value to animate from. Reduced motion
       is handled globally, which zeroes this along with everything else. */
    transition:
      left 420ms var(--ease-out),
      top 420ms var(--ease-out);
  }

  .card::-webkit-scrollbar {
    display: none;
  }

  .card[hidden],
  .card__panel[hidden] {
    display: none;
  }

  /* The scroll cue. `sticky` resolves against the scroll container, so it
     rides the foot of the card's scrollport while the panels move underneath.
     The negative margin keeps it out of the height it is reporting on, and
     the gradient runs to solid white so it meets the card's own padding with
     no seam. Understated on purpose: it is a hint that the list continues,
     not a rule under it. */
  .card__fade {
    position: sticky;
    bottom: 0;
    z-index: 1;
    display: block;
    height: 2.25rem;
    margin-top: -2.25rem;
    background: linear-gradient(to top, var(--c-white) 22%, rgba(255, 255, 255, 0));
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    pointer-events: none;
  }

  /* Set by the script, and only while there is somewhere left to scroll. */
  .card[data-more='true'] .card__fade {
    opacity: 1;
  }

  .card__close {
    position: absolute;
    top: var(--sp-24);
    right: var(--sp-24);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background-color: rgba(19, 20, 0, 0.55);
    color: var(--c-cream);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .card__close:hover,
  .card__close:focus-visible {
    background-color: var(--c-ink);
    transform: scale(1.08);
  }

  /* The single biggest thing the card can give back to the stage, so its
     height is on a viewport clamp. That height is *stated*, not derived from
     a ratio: `aspect-ratio` with a `max-height` re-derives the other axis when
     the height clamps, so a 4/3 box under a 150px ceiling came out 150 tall
     and 200 wide inside a 270px column — the picture was being narrowed by a
     rule meant only to cap how tall it got. Width fills; the picture crops
     rather than squashing, because it is `cover`. */
  .card__media {
    width: 100%;
    height: clamp(4.5rem, 15vh, 10rem);
    border-radius: var(--r-sm);
    background-color: var(--c-cream);
    overflow: hidden;
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__category {
    margin-top: var(--sp-16);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-steel-text);
  }

  .card__title {
    margin-top: var(--sp-8);
    font-size: var(--fs-h6); /* 24 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--c-ink);
  }

  .card__desc {
    margin-top: var(--sp-8);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .card__list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    margin-top: var(--sp-20);
  }

  .card__list li {
    display: flex;
    align-items: center;
    gap: var(--sp-12);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .card__tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--r-pill);
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  .card__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-12);
    margin-top: var(--sp-20);
    padding: var(--sp-12) var(--sp-20);
    border-radius: var(--r-sm);
    background-color: var(--c-ink);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    color: var(--c-primary);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .card__cta:hover,
  .card__cta:focus-visible {
    background-color: #23240a;
  }

  /* ---------- Tabs ---------- */

  .tabs {
    display: flex;
    justify-content: center;
    gap: var(--sp-2);
    align-self: center;
    flex: none;
    max-width: 100%;
    padding: clamp(0.25rem, 0.7vh, var(--sp-8));
    border: 1px solid rgba(19, 20, 0, 0.08);
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    box-shadow: var(--shadow-lg);
  }

  .tabs__tab {
    padding: clamp(0.25rem, 0.8vh, var(--sp-8)) var(--sp-20);
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: 1.4;
    color: var(--c-muted);
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .tabs__tab:hover {
    color: var(--c-ink);
  }

  .tabs__tab[aria-selected='true'] {
    background-color: var(--c-cream);
    color: var(--c-ink);
  }

  /* ---------- Thumbnails ---------- */

  .thumbs {
    display: flex;
    align-items: center;
    flex: none;
    gap: var(--sp-12);
  }

  .thumbs__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid rgba(19, 20, 0, 0.12);
    border-radius: var(--r-pill);
    background-color: var(--c-white);
    color: var(--c-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .thumbs__arrow:hover:not(:disabled),
  .thumbs__arrow:focus-visible {
    border-color: var(--c-ink);
    background-color: var(--c-cream);
  }

  .thumbs__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .thumbs__arrow--prev :global(svg) {
    transform: rotate(90deg);
  }

  .thumbs__arrow--next :global(svg) {
    transform: rotate(-90deg);
  }

  .thumbs__list {
    display: flex;
    flex: 1 1 auto;
    gap: var(--sp-12);
    margin: 0;
    padding: 0;
    list-style: none;
    /* Centred between the arrows, whatever the number of thumbnails.
       `safe` is doing real work here: plain `center` on a scroll container
       pushes the first item past the start edge once the strip overflows, and
       no amount of scrolling brings it back. `safe` falls back to `start` in
       exactly that case and centres in every other.

       This replaces a `width: fit-content` + auto-margin arrangement that was
       inert — `flex-grow: 1` sizes the strip before an auto margin ever sees
       free space, so the list filled the gap between the arrows and its items
       stacked up at the left of it. */
    justify-content: safe center;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .thumbs__list::-webkit-scrollbar {
    display: none;
  }

  /* Sized, then allowed to shrink only so far. Without the floor the items
     shrink for ever and the strip can never overflow — which sounds harmless
     until a template with a dozen views renders twelve 90px thumbnails
     instead of scrolling. Past the floor the strip scrolls, which is what the
     arrows and the snapping are for. */
  .thumbs__list > li {
    flex: 0 1 15rem;
    min-width: 8.5rem;
    scroll-snap-align: start;
  }

  .thumbs__item {
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--r-sm);
    /* No tile behind the car — the cutouts would otherwise sit on a cream
       chip, which is the box this section was asked to lose. */
    background-color: transparent;
    cursor: pointer;
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  /* An explicit height, not `aspect-ratio`. These are raw <img> tags carrying
     their intrinsic width/height attributes, and the global reset sets
     `max-width: 100%` without the usual `height: auto` — so the used height
     stays the attribute's (1615px here) and `aspect-ratio` never applies,
     because it only governs a dimension that is `auto`. Stating the height
     settles it without reaching into the reset. */
  .thumbs__item img {
    display: block;
    width: 100%;
    height: clamp(3rem, 7.5vh, 6.5rem);
    object-fit: contain;
  }

  .thumbs__item:hover {
    border-color: rgba(19, 20, 0, 0.2);
  }

  .thumbs__item[aria-current='true'] {
    border-color: var(--c-primary);
  }

  /* ---------- Responsive ---------- */

  /* Tablet landscape and down: the three-column header has no room for a
     centred title flanked by two controls, so it stacks. */
  @media (max-width: 1100px) {
    /* Title across the top, then the hint and the escape hatch sharing one
       row beneath it. Stacking all three costs seventy pixels of a viewport
       this section has to live inside, and buys nothing. */
    .explorer__head {
      grid-template-columns: auto auto;
      grid-template-areas:
        'title title'
        'hint reset';
      justify-content: center;
      align-items: center;
      gap: var(--sp-12) var(--sp-24);
      text-align: center;
    }

    .explorer__titles {
      grid-area: title;
    }

    .explorer__hint {
      grid-area: hint;
      text-align: start;
    }

    .explorer__reset {
      grid-area: reset;
      justify-self: start;
      height: 2.375rem;
    }

    .card {
      width: 17rem;
    }

    .explorer__body.has-card .stage {
      padding-inline-end: 18.5rem;
    }
  }

  /* ---------- Tablet portrait and phones ----------
     Below this the stage is too narrow to hold a card beside a marker, so the
     card becomes a sheet under the car and the connector goes — a lead line
     to a full-width sheet is noise, not a cue.

     The sheet shares the body's height with the stage rather than overlaying
     it or being added to it. Overlaying buries the car on a screen that has
     no room to spare; adding pushes the controls off the bottom, which is the
     one thing this section may not do. */
  @media (max-width: 820px) {
    .connector,
    .connector.is-on {
      display: none;
    }

    /* Two rows inside the body's fixed height rather than an overlay: the
       sheet takes the height it needs and the stage keeps the rest, so the
       car is never behind the card and the panel still cannot grow past the
       viewport. A hidden card is `display: none`, so with nothing open the
       row collapses and the stage has the lot. */
    .explorer__body {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: var(--sp-12);
    }

    .explorer__body.has-card .stage {
      padding-inline-end: 0;
    }

    .stage {
      grid-row: 1;
      min-height: 0;
    }

    /* The title says the same thing in fewer words, and from here down the
       height it costs is height the car does not have. */
    .explorer__sub {
      display: none;
    }

    .card {
      --card-mode: sheet;

      position: static;
      grid-row: 2;
      width: 100%;
      max-width: 32rem;
      /* Capped so a four-line spec list cannot push the car out of the
         section; past that it scrolls inside the sheet. */
      max-height: 16rem;
      justify-self: center;
    }

    .card__close {
      top: var(--sp-8);
      right: var(--sp-8);
    }

    /* Side by side, so the sheet costs a fraction of the height it does with
       the picture stacked above the text. */
    .card__panel {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      /* Declared, not implicit. `grid-row: 1 / -1` counts to the last line of
         the *explicit* grid, and with no rows declared that line is line 1 —
         so the span silently collapses to one row and the picture's height
         becomes row one's height, stranding the category label in a 136px
         band above the title. Five covers every panel's longest shape. */
      grid-template-rows: repeat(5, auto);
      gap: var(--sp-16);
      align-items: start;
    }

    /* A square set by the column's width, so the height goes back to auto and
       the ratio drives it — the opposite axis from the anchored card. */
    .card__media {
      grid-row: 1 / -1;
      align-self: start;
      height: auto;
      aspect-ratio: 1;
    }

    /* No end padding to clear the close button. The button is out of flow and
       the category is a short label — measured, it ends between 92 and 254px
       short of the button on every screen this layout runs at, the narrowest
       being a 360px phone. Reserving space for a collision that cannot happen
       would only narrow the row. */
    .card__category {
      margin-top: 0;
    }

    .card__category,
    .card__title,
    .card__desc,
    .card__list,
    .card__cta {
      grid-column: 2;
    }
  }

  /* ---------- Phones ---------- */
  @media (max-width: 700px) {
    .explorer {
      padding-inline: var(--sp-12);
    }

    .explorer__panel {
      padding: var(--sp-16) var(--sp-12);
    }

    /* The header is a third of a phone screen if it keeps all four of its
       parts. The title stays, and the two that a phone does not need go: the
       standfirst repeats what the title says, and "drag or swipe" is a hint
       about a gesture that phones make first anyway — the tabs below name
       every view outright. Their height goes to the car. */
    .explorer__sub,
    .explorer__hint {
      display: none;
    }

    /* The markers keep their size here — the brief for this section is that
       they stay easy to tap, and 46px is already the WCAG target. */

    /* Wrapping beats a squeezed row; the thumbnails below do the same job
       with pictures. */
    .tabs {
      flex-wrap: wrap;
      justify-content: center;
      border-radius: var(--r-lg);
    }

    /* Stacked on phones: picture across the top, then the words under it, in
       reading order. The two-column sheet above buys its height by giving the
       text a 200px column, which is where the description and every checklist
       row start wrapping — stacked, the same words get the card's full width
       and take fewer lines back, so most of the picture's height is paid for
       rather than added. Unset rather than overridden, so the block flow the
       anchored card already uses comes back. */
    .card__panel {
      display: block;
    }

    /* A banner across the top, not the column-width square the two-column
       sheet made of it. Short, because on a phone the checklist is what the
       marker was tapped for. The close button lands on this rather than on
       any text, which is the other thing stacking buys. */
    .card__media {
      width: 100%;
      /* A ratio, not a viewport height: the crop then stays the same shape on
         every phone instead of getting squarer on tall screens and slotlike
         on short ones. No `max-height` with it — a ratio under a height cap
         re-derives the *width*, which is what narrowed this picture once
         before. The card's own cap is what protects the section. */
      height: auto;
      aspect-ratio: 5 / 2;
    }

    .card__category {
      margin-top: var(--sp-12);
    }

    .card {
      /* Two rem more than the two-column sheet needed: stacking spends height
         on the banner and wins some back from the wider text, but not all of
         it, and this keeps the first checklist row in view alongside a picture
         big enough to read the car in.

         The `vh` half is not decoration. A flat rem cap is a fixed bite out of
         a budget that is not fixed, so on a short phone the card takes the
         same 300px out of a much smaller body and leaves the car a sliver —
         measured, 47px at 360x640. Whichever is smaller keeps the split
         sane at both ends. */
      max-height: min(19rem, 40vh);
      padding: var(--sp-12);
    }

    .card__title {
      font-size: var(--fs-body);
    }

    .card__list {
      margin-top: var(--sp-12);
      gap: var(--sp-8);
    }

    .thumbs__list > li {
      flex: 0 0 5rem;
    }

    .thumbs__arrow {
      display: none;
    }
  }

  /* Phone portrait: the thumbnail strip repeats what the tabs already do, and
     three tabs are legible on their own. Its height goes to the car. */
  @media (max-width: 560px) {
    .thumbs {
      display: none;
    }
  }

  /* ---------- Short and wide ----------
     A phone held sideways, or a short desktop window. Stacking the car above
     two rows of controls in 390px leaves a car an inch tall, so the layout
     turns: the stage keeps the full height of the panel and the tabs stand
     beside it in a column. Reorganised rather than shrunk, which is the only
     way this one fits at all — and because it now does fit, it takes the
     viewport here too. */
  @media (max-height: 560px) and (orientation: landscape) {
    .explorer {
      height: calc(100vh - var(--header-h));
      height: calc(100svh - var(--header-h));
    }

    .explorer__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto minmax(0, 1fr);
      align-items: center;
    }

    .explorer__head {
      grid-column: 1 / -1;
    }

    .explorer__body {
      grid-column: 1;
      grid-row: 2;
      height: 100%;
    }

    .stage__viewport {
      aspect-ratio: auto;
    }

    .tabs {
      grid-column: 2;
      grid-row: 2;
      flex-direction: column;
      align-self: center;
      border-radius: var(--r-lg);
    }

    /* Pictures of three views, next to three buttons naming them. */
    .thumbs {
      display: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';
  import { views } from '../../data/hotspots';

  const section = document.querySelector<HTMLElement>('[data-explorer]');

  if (section) {
    const viewport = section.querySelector<HTMLElement>('[data-viewport]');
    const card = section.querySelector<HTMLElement>('[data-card]');

    if (viewport && card) {
      const images = Array.from(section.querySelectorAll<HTMLImageElement>('[data-view-image]'));
      const pins = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-pin]'));
      const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-tab]'));
      const thumbs = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
      const prevBtn = section.querySelector<HTMLButtonElement>('[data-thumb-prev]');
      const nextBtn = section.querySelector<HTMLButtonElement>('[data-thumb-next]');
      const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-card-panel]'));
      const closeBtn = section.querySelector<HTMLButtonElement>('[data-card-close]');
      const ground = section.querySelector<HTMLElement>('[data-ground]');
      const body = section.querySelector<HTMLElement>('[data-body]');
      const connector = section.querySelector<SVGSVGElement>('[data-connector]');
      const connectorPath = section.querySelector<SVGPathElement>('[data-connector-path]');
      const connectorHalo = section.querySelector<SVGPathElement>('[data-connector-path-halo]');
      const connectorDot = section.querySelector<SVGCircleElement>('[data-connector-dot]');
      const resetBtn = section.querySelector<HTMLButtonElement>('[data-reset]');

      const reduce = (): boolean => prefersReducedMotion();

      let view = 0;
      let openFeature: string | null = null;
      let zoom = 1;

      /* ---------- Marker placement ----------
         The image is `contain`ed, so it does not fill the stage. Markers are
         percentages of the *image*, so the letterboxed box has to be derived
         before they can be placed — otherwise every marker on a view whose
         aspect ratio differs from the stage lands somewhere else. */
      const placePins = (): void => {
        const img = images[view];
        if (!img) return;
        const box = viewport.getBoundingClientRect();
        const nw = img.naturalWidth || img.width;
        const nh = img.naturalHeight || img.height;
        if (!nw || !nh || !box.width) return;

        const scale = Math.min(box.width / nw, box.height / nh);
        const w = nw * scale;
        const h = nh * scale;
        const left = (box.width - w) / 2;
        const top = (box.height - h) / 2;

        pins.forEach((pin) => {
          if (Number(pin.dataset.view) !== view) return;
          pin.style.left = `${left + (Number(pin.dataset.x) / 100) * w}px`;
          pin.style.top = `${top + (Number(pin.dataset.y) / 100) * h}px`;
        });

        /* The ring belongs to the car, not to the stage. Sized and placed
           against the same rendered box the markers use: the stage is a
           flexible height and the render is `contain`ed inside it, so a ring
           positioned against the stage floats away from the wheels by
           whatever the letterbox happens to be. */
        if (ground && !ground.hidden) {
          const rw = w * 0.62;
          const rh = rw / 3;
          ground.style.width = `${Math.round(rw)}px`;
          ground.style.left = `${Math.round(left + w / 2)}px`;
          /* Centred on the car's contact line — the renders are trimmed to
             the car, so that is the foot of the picture. */
          ground.style.bottom = `${Math.round(box.height - (top + h * 0.97) - rh / 2)}px`;
        }

        /* The card hangs off a marker, so anything that moves markers moves
           the card too — resize, zoom, and switching view. */
        placeCard();
      };

      /* ---------- Card placement ----------
         The card sits beside the marker that opened it, on whichever side has
         room, and a connector runs between the two. Everything is measured
         rather than assumed: the marker has already been placed against the
         rendered image box, so its rect is the truth. */
      /* CSS owns the breakpoint. The script asks it which mode the card is in
         rather than carrying a copy of the number — the two drifting apart is
         a bug that shows up only at one width and looks like nothing else. */
      const anchored = (): boolean =>
        !!body && !!connector &&
        getComputedStyle(card).getPropertyValue('--card-mode').trim() === 'anchored';

      /** Gap between the panel edge and the card. */
      const EDGE = 8;
      /** Marker radius: where the lead line leaves the marker, so its first
          stretch is not hidden underneath the marker's own disc. */
      const PIN_R = 14;
      /** Below this the flip to the other edge is not worth the jump. */
      const MIN_RUN = 40;

      const activePin = (): HTMLElement | undefined =>
        pins.find((p) => !p.hidden && p.dataset.feature === openFeature);

      /* Draws the lead line between the active marker and the card.
         Deliberately reads the card's *live* rect rather than the position it
         was last told to take: while it glides from one marker to the next
         those two differ, and the line has to stay attached the whole way. */
      const syncConnector = (): void => {
        if (!body || !connector || !connectorPath || !connectorDot) return;
        if (card.hidden || openFeature === null || !anchored()) return;
        const pin = activePin();
        if (!pin) return;

        const bodyBox = body.getBoundingClientRect();
        const pinBox = pin.getBoundingClientRect();
        const cardBox = card.getBoundingClientRect();

        const px = pinBox.left + pinBox.width / 2 - bodyBox.left;
        const py = pinBox.top + pinBox.height / 2 - bodyBox.top;
        const cardL = cardBox.left - bodyBox.left;
        const cardR = cardBox.right - bodyBox.left;
        const cardT = cardBox.top - bodyBox.top;
        const cardB = cardBox.bottom - bodyBox.top;

        /* Out from the marker, then a right angle into the card's near edge —
           a straight diagonal reads as a stray rule rather than a lead line.
           When the marker already sits within the card's height the middle
           leg collapses and the run is simply horizontal, which is correct. */
        const toRight = px <= cardL;
        const startX = toRight ? px + PIN_R : px - PIN_R;
        const endX = toRight ? cardL : cardR;
        const endY = Math.max(cardT + 24, Math.min(py, cardB - 24));
        const midX = startX + (endX - startX) * 0.5;

        const d = `M ${startX} ${py} H ${midX} V ${endY} H ${endX}`;
        connector.setAttribute('viewBox', `0 0 ${bodyBox.width} ${bodyBox.height}`);
        connectorPath.setAttribute('d', d);
        connectorHalo?.setAttribute('d', d);
        /* The dot marks where the line lands, so it arrives with the card. */
        connectorDot.setAttribute('cx', String(endX));
        connectorDot.setAttribute('cy', String(endY));
        connector.classList.add('is-on');
      };

      /* The card moves under a CSS transition, which fires no frame callbacks
         of its own, so the line is re-cut on every frame for its duration. */
      let glideUntil = 0;
      let gliding = false;
      const followGlide = (): void => {
        syncConnector();
        if (performance.now() < glideUntil) requestAnimationFrame(followGlide);
        else gliding = false;
      };
      const startGlide = (): void => {
        glideUntil = performance.now() + 480;
        if (gliding) return;
        gliding = true;
        requestAnimationFrame(followGlide);
      };

      const placeCard = (): void => {
        /* Closing owns the connector's exit — bail out rather than snapping
           the line off the instant `openFeature` is cleared. */
        if (!body || card.hidden || openFeature === null) return;

        if (!anchored()) {
          card.style.left = '';
          card.style.top = '';
          connector?.classList.remove('is-on');
          return;
        }

        const pin = activePin();
        if (!pin) return;

        const bodyBox = body.getBoundingClientRect();
        const pinBox = pin.getBoundingClientRect();
        const cardW = card.offsetWidth;
        const cardH = card.offsetHeight;

        const px = pinBox.left + pinBox.width / 2 - bodyBox.left;
        const py = pinBox.top + pinBox.height / 2 - bodyBox.top;

        /* The card is parked against a panel edge rather than held a fixed
           distance from the marker: the car fills the middle of the stage, so
           hugging the marker drops the card onto the bodywork. Going to the
           edge clears as much of the car as the panel allows and leaves a
           lead line long enough to read.

           The right edge is the default, matching the reference. It flips
           only when the marker is so far right that the card would crowd or
           cover it — a rule of "whichever half the marker is in" would send
           the card skidding across the panel between two markers a few
           percent apart, which reads as a fault.

           What ties the card to the marker is therefore its vertical
           position and the connector, not proximity. */
        const rightLeft = bodyBox.width - cardW - EDGE;
        const toRight = px + PIN_R + MIN_RUN <= rightLeft;
        const left = toRight ? rightLeft : EDGE;
        const top = Math.max(EDGE, Math.min(py - cardH / 2, bodyBox.height - cardH - EDGE));

        const wasPlaced = card.style.left !== '';
        const nextLeft = `${Math.round(left)}px`;
        const nextTop = `${Math.round(top)}px`;
        const moved = wasPlaced && (card.style.left !== nextLeft || card.style.top !== nextTop);

        card.style.left = nextLeft;
        card.style.top = nextTop;

        if (moved && !reduce()) startGlide();
        syncConnector();
      };

      /* The draw is a dash the length of the whole path, offset out of sight
         and then pulled back in — the standard trick, and the reason the path
         carries no dash pattern of its own. */
      const drawConnector = (): void => {
        if (!connectorPath || !connectorDot) return;
        if (!connector?.classList.contains('is-on') || reduce()) return;
        const len = connectorPath.getTotalLength();
        gsap.fromTo(
          [connectorPath, connectorHalo].filter(Boolean),
          { strokeDasharray: len, strokeDashoffset: len },
          { strokeDashoffset: 0, duration: 0.42, ease: 'power2.out',
            clearProps: 'strokeDasharray,strokeDashoffset' },
        );
        gsap.fromTo(
          connectorDot,
          { scale: 0, transformOrigin: 'center' },
          { scale: 1, duration: 0.3, ease: 'back.out(2)', delay: 0.24, clearProps: 'all' },
        );
      };

      /* Closing runs the draw backwards, so the line retracts into the marker
         it came out of instead of blinking away with the card. */
      const retractConnector = (done: () => void): void => {
        if (!connectorPath || !connectorDot) { done(); return; }
        if (!connector?.classList.contains('is-on') || reduce()) { done(); return; }
        const len = connectorPath.getTotalLength();
        gsap.to(connectorDot, {
          scale: 0, transformOrigin: 'center', duration: 0.14, ease: 'power2.in',
        });
        gsap.fromTo(
          [connectorPath, connectorHalo].filter(Boolean),
          { strokeDasharray: len, strokeDashoffset: 0 },
          { strokeDashoffset: len, duration: 0.26, ease: 'power2.in', delay: 0.06,
            onComplete: done },
        );
      };

      /* The card scrolls with its scrollbar hidden, so the fade at its foot is
         the only thing reporting that there is more below. It is toggled, not
         left on: a permanent fade implies content that may not be there, and
         once you are at the bottom it is just a smudge over the last row. */
      const syncScrollCue = (): void => {
        const more = card.scrollHeight - card.clientHeight - card.scrollTop > 4;
        card.dataset.more = more ? 'true' : 'false';
      };

      const showPanel = (id: string | null): void => {
        panels.forEach((p) => (p.hidden = p.dataset.cardPanel !== id));
        /* A new subject starts at its own top. Carrying the old scroll offset
           over drops the visitor into the middle of a card they have not
           read, and leaves the cue describing the panel that just left. */
        card.scrollTop = 0;
        syncScrollCue();
      };

      const syncPins = (): void => {
        pins.forEach((pin) => {
          const mine = Number(pin.dataset.view) === view;
          pin.hidden = !mine;
          pin.setAttribute('aria-expanded', String(mine && pin.dataset.feature === openFeature));
        });
        placePins();
      };

      /* ---------- Card ---------- */

      const openCard = (id: string): void => {
        const first = openFeature === null;
        const previous = openFeature;
        openFeature = id;
        syncPins();
        card.hidden = false;
        /* What the card costs the stage — a side strip when it is anchored
           beside the car, a row beneath it when it is a sheet. Which of the
           two is the stylesheet's business; the script only says there is one
           open, so the breakpoint stays in one place. */
        body?.classList.add('has-card');

        const panel = panels.find((p) => p.dataset.cardPanel === id);
        if (!panel) return;

        if (reduce()) {
          showPanel(id);
          gsap.set(card, { clearProps: 'all' });
          placeCard();
          return;
        }

        if (first) {
          showPanel(id);
          placeCard();
          drawConnector();
          gsap.fromTo(
            card,
            { x: 26, opacity: 0, scale: 0.96 },
            { x: 0, opacity: 1, scale: 1, duration: 0.5, ease: 'power3.out' },
          );
          gsap.fromTo(
            panel,
            { opacity: 0, y: 10 },
            { opacity: 1, y: 0, duration: 0.36, ease: 'power2.out', delay: 0.1, clearProps: 'all' },
          );
        } else if (previous !== id) {
          /* Already open on another subject: the frame holds still and only
             its contents change. Closing and reopening reads as a glitch. */
          const outgoing = panels.find((p) => !p.hidden);
          const tl = gsap.timeline();
          if (outgoing) tl.to(outgoing, { opacity: 0, x: -16, duration: 0.16, ease: 'power2.in' });
          tl.add(() => {
            showPanel(id);
            placeCard();
            drawConnector();
          });
          tl.fromTo(
            panel,
            { opacity: 0, x: 22 },
            { opacity: 1, x: 0, duration: 0.32, ease: 'power3.out', clearProps: 'all' },
          );
          if (outgoing) tl.set(outgoing, { clearProps: 'all' });
        }
      };

      const closeCard = (): void => {
        if (openFeature === null) return;
        openFeature = null;
        syncPins();

        /* Two steps, because the connector outlives the card by a beat: the
           card goes first, then the line retracts behind it. Hiding the card
           the moment its fade ends also stops an invisible panel from
           swallowing clicks during the retract. */
        const hideCard = (): void => {
          card.hidden = true;
          showPanel(null);
          gsap.set(card, { clearProps: 'all' });
          card.style.left = '';
          card.style.top = '';
          /* Hand the strip back — the car returns to the full stage. */
          body?.classList.remove('has-card');
        };

        const dropConnector = (): void => {
          connector?.classList.remove('is-on');
          const strokes = [connectorPath, connectorHalo].filter(Boolean);
          if (strokes.length) {
            gsap.set(strokes, { clearProps: 'strokeDasharray,strokeDashoffset' });
          }
          if (connectorDot) gsap.set(connectorDot, { clearProps: 'all' });
        };

        if (reduce()) {
          hideCard();
          dropConnector();
          return;
        }
        gsap.to(card, {
          x: 28,
          opacity: 0,
          scale: 0.98,
          duration: 0.28,
          ease: 'power2.in',
          onComplete: () => {
            hideCard();
            retractConnector(dropConnector);
          },
        });
      };

      /* ---------- Views ---------- */

      const setView = (next: number, animate = true): void => {
        const clamped = Math.max(0, Math.min(views.length - 1, next));
        if (clamped === view) return;
        view = clamped;

        images.forEach((img, i) => (img.hidden = i !== view));
        if (ground) ground.hidden = views[view].ground === false;
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === view));
          tab.tabIndex = i === view ? 0 : -1;
        });
        thumbs.forEach((thumb, i) => {
          if (i === view) thumb.setAttribute('aria-current', 'true');
          else thumb.removeAttribute('aria-current');
        });
        if (prevBtn) prevBtn.disabled = view === 0;
        if (nextBtn) nextBtn.disabled = view === views.length - 1;

        /* A subject can appear on several views; if it is not on this one the
           card would be describing something no longer on screen. */
        if (openFeature && !views[view].hotspots.some((h) => h.feature === openFeature)) {
          closeCard();
        }
        syncPins();

        thumbs[view]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });

        if (animate && !reduce()) {
          gsap.fromTo(images[view], { opacity: 0.35 }, { opacity: 1, duration: 0.32, ease: 'power2.out' });
        }
      };

      /* ---------- Zoom ---------- */

      const applyZoom = (): void => {
        viewport.style.transform = zoom === 1 ? '' : `scale(${zoom})`;
        placePins();
      };

      const setZoom = (next: number): void => {
        zoom = Math.max(1, Math.min(2.2, Number(next.toFixed(3))));
        applyZoom();
      };

      /* Only with a modifier — which is exactly what a trackpad pinch sends.
         Taking the plain wheel would trap the page scroll over a section this
         tall and the visitor could not get past it. */
      viewport.addEventListener(
        'wheel',
        (event) => {
          if (!event.ctrlKey && !event.metaKey) return;
          event.preventDefault();
          setZoom(zoom - event.deltaY * 0.002);
        },
        { passive: false },
      );

      /* ---------- Drag / swipe ---------- */

      let dragging = false;
      let startX = 0;
      let stepped = 0;
      const STEP = 90; // px of travel per viewpoint

      viewport.addEventListener('pointerdown', (event) => {
        if ((event.target as HTMLElement).closest('[data-pin]')) return;
        dragging = true;
        startX = event.clientX;
        stepped = 0;
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const steps = Math.trunc((event.clientX - startX) / STEP);
        if (steps === stepped) return;
        setView(view + (steps > stepped ? 1 : -1));
        stepped = steps;
      });

      const endDrag = (event: PointerEvent): void => {
        if (!dragging) return;
        dragging = false;
        if (viewport.hasPointerCapture(event.pointerId)) {
          viewport.releasePointerCapture(event.pointerId);
        }
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      /* ---------- Wiring ---------- */

      pins.forEach((pin) => {
        pin.addEventListener('click', () => {
          const id = pin.dataset.feature;
          if (!id) return;
          if (id === openFeature) closeCard();
          else openCard(id);
        });
      });

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => setView(i));
        tab.addEventListener('keydown', (event) => {
          const key = event.key;
          if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
          event.preventDefault();
          const next = (i + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
          setView(next);
          tabs[next]?.focus();
        });
      });

      thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => setView(i)));
      prevBtn?.addEventListener('click', () => setView(view - 1));
      nextBtn?.addEventListener('click', () => setView(view + 1));
      closeBtn?.addEventListener('click', closeCard);

      resetBtn?.addEventListener('click', () => {
        closeCard();
        setZoom(1);
        setView(0);
        syncPins();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && openFeature !== null) closeCard();
      });

      /* ---------- Placement lifecycle ----------
         Markers depend on the rendered image box, which depends on the image
         having decoded and on the stage's size. Both are waited for rather
         than assumed. */
      new ResizeObserver(() => placePins()).observe(viewport);

      /* Whether there is more to scroll changes with the card's own size, not
         the stage's — a rotation or a font swap can reflow the copy past the
         cap without the viewport moving at all. */
      new ResizeObserver(() => syncScrollCue()).observe(card);
      card.addEventListener('scroll', syncScrollCue, { passive: true });

      images.forEach((img) => {
        if (img.complete) return;
        img.addEventListener('load', () => placePins(), { once: true });
      });

      void document.fonts?.ready.then(() => placePins());
      if (ground) ground.hidden = views[0].ground === false;
      syncPins();

      if (!reduce()) {
        gsap.fromTo(
          pins.filter((p) => !p.hidden),
          { scale: 0, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.55,
            ease: 'back.out(1.7)',
            stagger: 0.07,
            /* Handed back to CSS, or the inline transform would beat the
               translate(-50%,-50%) that centres each marker on its point. */
            clearProps: 'transform,opacity',
            scrollTrigger: { trigger: section, start: 'top 75%', once: true },
          },
        );
      }
    }
  }
</script>

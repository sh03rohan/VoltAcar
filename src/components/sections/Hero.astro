---
import { Image } from 'astro:assets';
import Button from '../common/Button.astro';
import heroCar from '../../assets/images/hero-car.webp';

/**
 * Home hero — Figma #13:82 (1600x800).
 *
 * The car render sits behind a radial scrim; the copy block starts 234px
 * down at 684px wide, and the four stats sit on a 1400px space-between row
 * 728px down.
 */
const stats = [
  { value: '500 km', label: 'Range on a single charge' },
  { value: '30 minutes', label: 'Fast charge to 80%' },
  { value: '0–100 km/h', label: 'Smooth driving experience' },
  { value: '20+', label: 'Intelligent safety features' },
];
---

<section class="hero on-dark" data-hero>
  <div class="hero__media">
    <Image
      src={heroCar}
      alt=""
      widths={[768, 1280, 1920, 2600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__image"
      data-hero-image
    />
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <div class="hero__copy">
        <h1 class="hero__title" data-hero-title>
          When <span class="hero__title-accent">Innovation</span> Meets the Road
        </h1>
        <p class="hero__lead" data-hero-lead>
          Meet VoltACar — a smarter, cleaner, and fully electric way to move.
        </p>
      </div>
      <div class="hero__cta" data-hero-cta>
        <Button label="Take a Test Drive" href="/test-drive" variant="light" />
      </div>
    </div>

    <ul class="hero__stats" role="list">
      {
        stats.map((stat) => (
          <li class="hero__stat" data-hero-stat>
            <span class="hero__stat-value">{stat.value}</span>
            <span class="hero__stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    /* Figma #13:82. Named because the render's placement is derived from it
       below — change one and the other has to follow. */
    --band-h: 50rem; /* 800 */
    min-height: var(--band-h);
    color: var(--c-cream);
    /* The render covers the whole band on desktop, but the narrow layout
       leaves ink above the strip — without this the scrim would composite
       over the cream page instead, which is what capped the headline's
       contrast at 5.4:1. */
    background-color: var(--c-ink);
    overflow: hidden;
  }

  /* ---------- Media ---------- */

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Figma #14:86 places the render 2033x1053 at (0, -118) in the 1600x800
     band — a 127% zoom with 118px cropped off the top and 135 off the bottom.
     Both crops carry the composition: the top one keeps the bright sky out,
     and the bottom one is what leaves the car standing clear of the band's
     lower edge rather than sitting on it.

     This used to be gated at 1400px, with a plain `cover` fit underneath,
     because a crop measured off the *width* runs out of height once the
     viewport is narrower than about 1396 and stops covering an 800px band.
     But cover re-frames everything — measured at 1366 it enlarged the car by
     a third and walked it left into the headline — so the band lost the
     design's composition at exactly the widths most laptops use.

     Measuring off the band's height instead keeps the framing at any width.
     The render is held at 2.5412 x the band height, which is the same 2033px
     when the band is 800, and the horizontal anchor slides so the car stays
     at the same fraction across the band. At 1600 both terms meet and this
     resolves to the frame's own numbers; wider, the width term takes over so
     the render still reaches the far edge. */
  .hero__image {
    /* 2033 / 800 — the render's width expressed against the band's height. */
    --img-w: calc(var(--band-h) * 2.5412);
    /* Where the frame cuts the render on the right: 1600 of its 2033, which
       is 2x the band height. Holding that edge is what keeps the car whole. */
    --img-right: calc(var(--band-h) * 2);

    position: absolute;
    top: -14.75%; /* -118 / 800 */
    /* Narrower than the frame, the crop comes off the *left* — the empty
       hillside — because the frame's own right-hand cut is what sets where
       the car sits. Anchoring the car's centre instead reads fine until the
       band is narrow enough that its rear wheel leaves the frame, which at
       1200 it did. Zero at 1600, so the frame's placement is exact there. */
    left: min(0px, calc(100% - var(--img-right)));
    width: max(127.0625%, var(--img-w)); /* 2033 / 1600 */
    height: auto;
    max-width: none;
  }

  /* radial-gradient(circle at 57% 56%, ...) — Figma #14:86 */
  /* The radial alone is centred on the car, not on the copy, and it left the
     headline at 1.81:1 and the lead at 3.80:1 around 1280 — where the crop has
     started pulling the bright bodywork under the text but no wash applied
     yet. A directional wash now rides on top at every width, anchored to where
     the 684 copy column actually ends so the release tracks the text rather
     than a fixed share of the band. Same treatment as PageHero. */
  .hero__scrim {
    --wash-end: calc(var(--gutter) + 42.75rem); /* 684 copy column */
    /* Graded by width, as PageHero is: the frame's placement holds at 1600 and
       the failures were all a consequence of the crop below it. */
    --wash-near: 0.45;
    --wash-mid: 0.38;
    --wash-far: 0.2;

    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(19, 20, 0, var(--wash-near)) 0,
        rgba(19, 20, 0, var(--wash-mid)) calc(var(--gutter) + 34.2rem),
        rgba(19, 20, 0, var(--wash-far)) var(--wash-end),
        rgba(19, 20, 0, 0) calc(var(--wash-end) + 12rem)
      ),
      /* The MCP reports this as `circle at 57% 56%` with no radius, and CSS
         then falls back to farthest-corner. Every other scrim on the site had
         its true radius recovered by rendering the scrim rect alone and
         inverting its alpha map — but this one is a *fill on the image rect*
         (#14:86 carries both the gradient and the photograph), so there is no
         isolated node to render.

         75% / 142% is therefore a best fit found by searching against the
         frame render, not a recovered geometry: 2.19% -> 2.02%. It is
         entangled with the wash above it, so re-fit if that changes. */
      radial-gradient(
        75% 142% at 57% 56%,
        rgba(19, 20, 0, 0) 0%,
        rgba(19, 20, 0, 0.43) 29%,
        rgba(19, 20, 0, 0.83) 100%
      );
  }

  @media (max-width: 1400px) {
    .hero__scrim {
      --wash-near: 0.72;
      --wash-mid: 0.66;
      --wash-far: 0.52;
    }
  }

  /* ---------- Layout ---------- */

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-80);
    width: 100%;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    /* Figma: copy starts at y=234, stats end 24px above the frame edge. */
    padding: 14.625rem var(--gutter) var(--sp-24);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-48); /* Figma #15:104 */
    max-width: 42.75rem; /* 684 */
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--sp-24); /* Figma #15:91 */
  }

  .hero__title {
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    text-wrap: balance;
  }

  .hero__title-accent {
    color: var(--c-primary);
  }

  .hero__lead {
    max-width: 23rem; /* 368 */
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }

  /* ---------- Stats ---------- */

  .hero__stats {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-32);
    margin: 0;
    padding: 0;
  }

  /* Figma #19:135: the first item hugs its text, the other three are fixed at
     207px, which is what produces the row's uneven-looking spacing. */
  .hero__stat {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    width: 12.9375rem; /* 207 */
    color: var(--c-white);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .hero__stat:first-child {
    width: auto;
  }

  .hero__stat-value {
    font-weight: var(--fw-medium);
  }

  .hero__stat-label {
    font-weight: var(--fw-regular);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1100px) {
    .hero__inner {
      padding-top: 11rem;
    }
  }

  @media (max-width: 992px) {
    .hero__stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-24) var(--sp-32);
    }

    .hero__stat {
      max-width: none;
    }
  }

  @media (max-width: 768px) {
    /* Content-driven rather than 100svh. The headline, lead, CTA and four
       stacked stats already make this the tallest band on the site, so the
       viewport floor only ever added dead space below the stat row. */
    .hero {
      min-height: 34rem;
    }

    .hero__inner {
      padding-top: 7.5rem;
      gap: var(--sp-48);
    }

    /* A full-bleed `cover` in a portrait box scaled the render to the taller
       edge and cropped it to a wheel and a door. As a bottom-anchored 4:3
       strip the whole car reads instead, and the mask hands the top of the
       strip back to the ink the copy sits on. */
    .hero__image {
      inset: auto 0 0;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-position: 56% 52%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 42%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 42%);
    }

    /* The copy sits directly over the car here, so the wash becomes vertical
       rather than directional — and eases off across the stat row, which the
       strip now sits behind in the clear. */
    .hero__scrim {
      background: linear-gradient(
        to bottom,
        rgba(19, 20, 0, 0.8) 0%,
        /* 0.55 here put the lead at 4.47:1 — under the 4.5 floor by a hair,
           at the one width where the copy sits over the brightest part of the
           strip. */
        rgba(19, 20, 0, 0.66) 45%,
        /* Unlike the inner pages nothing here is ever fully in the clear —
           the stat row runs to the foot — so the wash tightens again over the
           bottom third rather than releasing. */ rgba(19, 20, 0, 0.6) 70%,
        rgba(19, 20, 0, 0.72) 100%
      );
    }

    .hero__lead {
      max-width: 28rem;
    }
  }

  @media (max-width: 480px) {
    .hero__stats {
      grid-template-columns: 1fr;
      gap: var(--sp-16);
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero && !prefersReducedMotion()) {
    const title = hero.querySelector('[data-hero-title]');
    const lead = hero.querySelector('[data-hero-lead]');
    const cta = hero.querySelector('[data-hero-cta]');
    const stats = hero.querySelectorAll('[data-hero-stat]');
    const image = hero.querySelector<HTMLElement>('[data-hero-image]');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Mask reveal rather than a plain fade — the headline wipes up into view.
    if (title) {
      tl.fromTo(
        title,
        { clipPath: 'inset(0 0 100% 0)', y: 40 },
        { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.1 },
      );
    }

    // Settles back to scale 1 so the resting frame matches the Figma crop
    // exactly — any residual scale would enlarge the render.
    if (image) {
      tl.fromTo(
        image,
        { scale: 1.1 },
        { scale: 1, duration: 1.6, ease: 'power2.out' },
        0,
      );
    }

    if (lead) tl.fromTo(lead, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, 0.35);
    if (cta) tl.fromTo(cta, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, 0.5);

    if (stats.length) {
      tl.fromTo(
        stats,
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.6, stagger: 0.09 },
        0.65,
      );
    }

    // Gentle parallax: the render drifts slower than the page.
    if (image) {
      gsap.to(image, {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      });
    }
  }
</script>

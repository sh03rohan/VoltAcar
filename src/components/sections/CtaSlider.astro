---
import type { ImageMetadata } from 'astro';
import CtaBanner from './CtaBanner.astro';

/**
 * Charging CTA banners presented as a horizontal slider driven by vertical
 * scroll: the section pins on entry, the track translates left as the page
 * scrolls, and the pin releases once the last card is reached.
 *
 * Home runs the three charging cards (#37:40, #55:139, #55:91); Features runs
 * its own three (#128:429 plus the canvas variants #143:729 and #143:737),
 * whose first card sits its copy at the foot rather than splitting it. The
 * cards are CtaBanner either way — only the data differs, so it is a prop.
 */
export interface CtaCard {
  /** Runs before the accent. */
  title: string;
  /** The lime run. */
  titleAccent?: string;
  /** Runs after the accent. */
  titleTrail?: string;
  /** Home's cards break hard after `title`; Features wraps naturally. */
  breakAfterTitle?: boolean;
  body: string;
  image: ImageMetadata;
  alt: string;
  /** The card's radial scrim, taken from its Figma fill. */
  scrim: string;
  /**
   * Focal point for the `cover` fit. The assets are already cropped to the
   * card's exact window, so this only decides what a taller-than-2.05 panel
   * trims from the sides — biased right to keep the car fully in frame.
   */
  focus?: string;
  /** Where the copy sits in the 620 frame. */
  align?: 'split' | 'foot';
  titleWidth?: number;
  bodyWidth?: number;
}

interface Props {
  cards: CtaCard[];
  /** Names the carousel for assistive tech. */
  label?: string;
}

const { cards, label = 'Charging options' } = Astro.props;
---

<section class="cta" data-cta-slider aria-roledescription="carousel" aria-label={label}>
  <div class="cta__track" data-cta-track>
    {
      cards.map((card, i) => (
        <CtaBanner
          layout="panel"
          align={card.align ?? 'split'}
          title={card.title}
          breakAfterTitle={card.breakAfterTitle}
          titleAccent={card.titleAccent}
          titleTrail={card.titleTrail}
          body={card.body}
          image={card.image}
          alt={card.alt}
          scrim={card.scrim}
          focus={card.focus}
          titleWidth={card.titleWidth}
          bodyWidth={card.bodyWidth}
          eager={i === 0}
          label={`${i + 1} of ${cards.length}`}
        />
      ))
    }
  </div>
</section>

<style>
  .cta {
    position: relative;
    /* Guards against the track ever widening the page while it is offset. */
    overflow: hidden;
  }

  .cta__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* Without the pinned slider the cards simply stack, so the content is never
     dependent on the scroll animation running. */
  @media (prefers-reduced-motion: reduce) {
    .cta__track {
      flex-direction: column;
      width: 100%;
    }

    .cta__track :global(.panel--panel) {
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: 1600 / 780;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '../../scripts/motion';

  /* Every instance sets up independently, so a page may carry more than one. */
  document.querySelectorAll<HTMLElement>('[data-cta-slider]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-cta-track]');
    if (!track || prefersReducedMotion()) return;

    /**
     * Distance the track must travel: its full width minus one viewport, so
     * the run ends exactly when the last card is flush with the right edge.
     * Read lazily so ScrollTrigger recalculates it on resize rather than
     * baking in the width at load.
     */
    const distance = (): number => track.scrollWidth - window.innerWidth;

    const travel = gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
    });

    ScrollTrigger.create({
      trigger: section,
      // Pins the moment the section's top meets the viewport's top, so the
      // first card is held full-bleed before anything moves sideways.
      start: 'top top',
      // Scroll length equals the horizontal travel, so one pixel of scroll is
      // one pixel of slide and the pin releases on the last card.
      end: () => `+=${distance()}`,
      pin: true,
      // A little smoothing so the track eases toward the scroll position in
      // both directions rather than tracking it rigidly.
      scrub: 0.8,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      animation: travel,
    });
  });

  // The panels are sized in viewport units, so a resize changes both the
  // travel distance and the pin length.
  if (!prefersReducedMotion()) {
    window.addEventListener('resize', () => ScrollTrigger.refresh());
  }
</script>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The inner-page hero: a full-bleed render behind a radial scrim, with a
 * heading and a lead paragraph placed off the frame's own coordinates.
 *
 * Every inner page in the Figma uses this same 1600x780 band and varies only
 * the render, the scrim, and where the copy block starts — so those are the
 * props. The Home hero (#13:82) keeps its own component: it carries a CTA and
 * the four-stat row, and its render is placed differently.
 *
 * Placement numbers come straight off the frame's image rect, as percentages
 * of the 1600x780 band. Rather than gate the exact crop behind a breakpoint,
 * the image carries a `min-height` equal to its own overhang, so it keeps the
 * frame's placement while the proportional crop still covers the band and
 * falls back to a `cover` fit once it no longer does.
 */
interface Props {
  /** Small label above the heading, 8px clear of it — Blog (#237:843). */
  eyebrow?: string;
  /** Leading run of the heading. */
  title: string;
  /** Lime-highlighted run, rendered between `title` and `titleTrail`. */
  titleAccent?: string;
  titleTrail?: string;
  body?: string;
  image: ImageMetadata;
  /** Empty by default — the render is decoration behind the copy. */
  imageAlt?: string;
  /** The frame's radial scrim, as a full CSS background value. */
  scrim: string;
  /** Image rect as a share of the band: width, then its offsets. */
  imageWidth?: number;
  imageLeft?: number;
  imageTop?: number;
  /** Focal point once the band is too tall for the proportional crop. */
  imageFocus?: string;
  /**
   * Focal point for the narrow layout, where the render becomes a short strip
   * rather than a full-bleed crop and so wants a different subject anchor.
   */
  imageFocusNarrow?: string;
  /** Copy block width and body width, in px, from the frame. */
  copyWidth?: number;
  bodyWidth?: number;
  /**
   * Heading measure, where the frame gives it one of its own. It runs either
   * way: 1102 inside a 1042 column on the blog single (#83:536), 648 inside
   * an 879 one on the test drive (#115:119). Both are load bearing — each
   * changes where the title breaks.
   */
  titleWidth?: number;
  /**
   * Where the copy block starts, in px. 265 on every frame but the blog
   * single (#83:532), which sits at 250 — the only page whose heading runs to
   * two full lines.
   */
  copyTop?: number;
  /**
   * Where the lead sits under the heading. The blog single (#83:527) drops it
   * clear of the heading and hangs it off the copy block's right edge instead
   * of its left — the frame places it at x=457 with a 687 measure, and
   * 457 + 687 is the copy block's own 1042 to within 2px, so it is an
   * alignment rather than an arbitrary indent.
   */
  leadAlign?: 'start' | 'end';
}

const {
  eyebrow,
  title,
  titleAccent,
  titleTrail,
  body,
  image,
  imageAlt = '',
  scrim,
  imageWidth = 100,
  imageLeft = 0,
  imageTop = 0,
  imageFocus = '60% 50%',
  imageFocusNarrow = imageFocus,
  copyWidth = 859,
  bodyWidth = 803,
  titleWidth = copyWidth,
  copyTop = 265,
  leadAlign = 'start',
} = Astro.props;

/* The render is wider than the band by design, so `100vw` would understate it
   and the browser would pick a variant it then has to rescale. Offering the
   frame's own pixel width as a candidate lets the desktop case decode 1:1. */
const naturalWidth = Math.round((1600 * imageWidth) / 100);
const widths = [...new Set([768, 1280, naturalWidth, 1920, 2400])].sort((a, b) => a - b);

const vars = {
  scrim,
  imgWidth: `${imageWidth}%`,
  imgLeft: `${imageLeft}%`,
  imgTop: `${imageTop}%`,
  /* Covers the band even where the proportional crop has become too short. */
  imgMinHeight: `${100 - imageTop}%`,
  imgFocus: imageFocus,
  imgFocusNarrow: imageFocusNarrow,
  copyWidth: `${copyWidth / 16}rem`,
  bodyWidth: `${bodyWidth / 16}rem`,
  titleWidth: `${titleWidth / 16}rem`,
  copyTop: `${copyTop / 16}rem`,
  /* The drop ramps at 10vw, which is 160px of the 1600 frame, so the fixed
     part of the ramp is whatever is left of the frame's own value. Without
     this the ramp always peaks at 265 and a larger `copyTop` raises only the
     ceiling — a clamp whose middle term never reaches it. */
  copyBase: `${(copyTop - 160) / 16}rem`,
};
---

<section class="page-hero on-dark" data-page-hero>
  <div class="page-hero__media">
    <Image
      class="page-hero__image"
      src={image}
      alt={imageAlt}
      widths={widths}
      sizes={`${imageWidth}vw`}
      loading="eager"
      fetchpriority="high"
      data-page-hero-image
    />
    <div class="page-hero__scrim"></div>
  </div>

  <div class="page-hero__inner">
    <div class="page-hero__copy">
      {/* Grouped so the eyebrow sits 8 from the heading while the block below
          keeps the copy column's own 24. */}
      <div class="page-hero__head">
        {eyebrow && <p class="page-hero__eyebrow" data-page-hero-lead>{eyebrow}</p>}
        {/* A newline in `title` is the frame's own hard break (#73:584 sets
            "Our Promise to \nProtect Your Data"). It is kept as a <br> rather
            than reverse-engineered into a measure, and dropped below 992
            where the column is too narrow for the designed break to help. */}
        <h1 class="page-hero__title" data-page-hero-title>
          {title.split('\n').map((line, i) => (
            <>
              {i > 0 && <br class="page-hero__break" />}
              {line}
            </>
          ))}{titleAccent && <span class="page-hero__accent">{titleAccent}</span>}{titleTrail}
        </h1>
      </div>
      {
        body && (
          <p class:list={['page-hero__lead', `page-hero__lead--${leadAlign}`]} data-page-hero-lead>
            {body}
          </p>
        )
      }
      {
        Astro.slots.has('default') && (
          <div class="page-hero__actions" data-page-hero-lead>
            <slot />
          </div>
        )
      }
    </div>
  </div>
</section>

<style define:vars={vars}>
  .page-hero {
    position: relative;
    display: flex;
    min-height: var(--banner-h); /* 780 */
    color: var(--c-cream);
    background-color: var(--c-ink);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__image {
    position: absolute;
    top: var(--imgTop);
    left: var(--imgLeft);
    width: var(--imgWidth);
    height: auto;
    min-height: var(--imgMinHeight);
    max-width: none;
    object-fit: cover;
    object-position: var(--imgFocus);
  }

  /* The frame's radial scrim alone is not enough on any of these renders. A
     sweep of every hero at six widths failed 18 times — worst 2.07:1 on the
     Features heading — because the radial is centred on the *render's*
     subject, not on the copy, and the copy's share of the band grows as the
     viewport narrows.

     So a directional wash rides on top at every width, anchored to where the
     copy actually ends rather than to a share of the band: stated against
     `--gutter + --copyWidth`, the release tracks the text instead of drifting
     across it, and the render keeps its own light beyond that point. */
  .page-hero__scrim {
    --wash-end: calc(var(--gutter) + var(--copyWidth));
    /* Graded by width on purpose. At 1600 the frame's own composition nearly
       works — only the Features lead fell short, at 4.23:1 — so the wash there
       is the lightest thing that clears the floor, and the band still reads as
       designed. Below 1400 the render is scaled up to cover and the bright
       bodywork drifts in under the copy, which is where the real failures
       were; the veil doubles to meet them. Running the heavy value everywhere
       cost 5.96% against the Features frame for no accessibility gain. */
    --wash-near: 0.34;
    --wash-mid: 0.28;
    --wash-far: 0.16;

    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(19, 20, 0, var(--wash-near)) 0,
        rgba(19, 20, 0, var(--wash-mid)) calc(var(--gutter) + var(--copyWidth) * 0.8),
        rgba(19, 20, 0, var(--wash-far)) var(--wash-end),
        rgba(19, 20, 0, 0) calc(var(--wash-end) + 12rem)
      ),
      var(--scrim);
  }

  @media (max-width: 1400px) {
    .page-hero__scrim {
      --wash-near: 0.72;
      --wash-mid: 0.66;
      --wash-far: 0.52;
    }
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    /* The frame's own drop, held only where the band is at full height; the
       ramp below it is the same on every page. */
    padding: clamp(9rem, calc(var(--copyBase) + 10vw), var(--copyTop)) var(--gutter) var(--sp-80);
  }

  .page-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-24);
    /* Whichever of the two is wider sets the column; the narrower one caps
       itself. That way a heading may run past the copy block, or sit inside
       it, without either case needing its own rule. */
    max-width: max(var(--copyWidth), var(--titleWidth));
  }

  .page-hero__head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .page-hero__eyebrow {
    font-size: var(--fs-lead); /* 20 */
    line-height: var(--lh-body);
  }

  /* Figma #237:841: 48 below the copy block, which is the column's own 24
     plus this. */
  .page-hero__actions {
    margin-top: var(--sp-24);
  }

  .page-hero__title {
    max-width: var(--titleWidth);
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
  }

  .page-hero__accent {
    color: var(--c-primary);
  }

  .page-hero__lead {
    max-width: var(--bodyWidth);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }

  /* Hangs off the copy block's right edge rather than its left, and drops
     clear of the heading: the frame's y=504 against a heading that ends at
     394, of which the column's own 24 is already spent.

     The margin puts the column's edge back where the copy block's is, since
     the column has been widened to hold the heading. */
  .page-hero__lead--end {
    align-self: flex-end;
    margin-top: 5.375rem; /* 86 */
    margin-right: max(0px, calc(var(--titleWidth) - var(--copyWidth)));
  }

  /* The frame's band is a 2.05:1 landscape crop. Holding its 780px height at
     phone widths turns the box portrait, and because `cover` scales to the
     taller edge it then throws away roughly three quarters of the render's
     width — the car arrives as an unreadable close-up under a lot of dead
     space.

     Shortening the section alone would not fix that: the crop follows the
     image box, not the band. So below this breakpoint the section is sized by
     its copy, and the render becomes a bottom-anchored 4:3 strip masked into
     the ink behind it. That takes the visible share of the render from ~27%
     to ~69% while the copy still sits over the photograph. */
  @media (max-width: 768px) {
    .page-hero {
      min-height: 30rem;
    }

    .page-hero__inner {
      /* The head clears the collapsed header, which is 40-64 here rather than
         the 80 the desktop padding was sized against; the foot reserves a
         clear strip so the render is never only a backdrop. Together they were
         328px against a copy block of ~374 — nearly half the band was padding,
         which is what made these run so tall. */
      padding-block: 6rem 9rem;
    }

    .page-hero__image {
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      height: auto;
      /* Overrides the desktop overhang, which would re-inflate the box. */
      min-height: 0;
      aspect-ratio: 4 / 3;
      /* 4:3 is right at phone widths but runs away as the viewport grows — at
         768 it made the strip 576 of a 702 band, so the copy had nowhere to
         sit that was not over the photograph. Capping it against the band
         keeps the balance and, because the box gets shorter rather than
         narrower, shows more of the render rather than less. */
      max-height: 55%;
      object-position: var(--imgFocusNarrow);
      /* Reaches full strength only at 42%, which is where the car's body
         starts. The band above it is sky and roof — the brightest part of
         every render, and exactly what the copy overlaps — so fading it back
         into the ink buys the contrast without dimming the subject. */
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 42%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 42%);
    }

    /* The radial scrim was measured against the full band and reads far too
       heavy over a strip, so the narrow layout carries its own vertical wash:
       dense under the copy, easing off across the exposed foot. */
    .page-hero__scrim {
      background: linear-gradient(
        to bottom,
        rgba(19, 20, 0, 0.76) 0%,
        rgba(19, 20, 0, 0.72) 45%,
        /* Holds to ~72%, which is where the copy now ends: the shorter foot
           padding and the full-width measure both push it lower and further
           right, over the sunlit part of the render rather than clear of it.
           Releasing at the old 62% left the lead at 2.89:1. */
          rgba(19, 20, 0, 0.7) 72%,
        rgba(19, 20, 0, 0.3) 86%,
        rgba(19, 20, 0, 0.18) 94%,
        rgba(19, 20, 0, 0.45) 100%
      );
    }

    /* The frame's measure is set against a 1400 container. Holding a fixed one
       here left the lead stopping well short of a heading that spans the whole
       column — 480 against 671 at 768 — so the two now share an edge. */
    .page-hero__lead {
      max-width: none;
    }

    /* The measure now fills the column, so there is nothing left to hang the
       lead off and the 86 drop is only dead band. */
    .page-hero__lead--end {
      margin-top: 0;
      margin-right: 0;
    }
  }

  /* Below the container's own width the frame's break is no longer the
     shortest line — the browser's is. */
  @media (max-width: 992px) {
    .page-hero__break {
      display: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-page-hero]');

  if (hero && !prefersReducedMotion()) {
    const title = hero.querySelector('[data-page-hero-title]');
    // Eyebrow, lead and any CTA all settle together, so this is a list — a
    // single lookup would only ever animate whichever came first.
    const lead = hero.querySelectorAll('[data-page-hero-lead]');
    const image = hero.querySelector<HTMLElement>('[data-page-hero-image]');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    if (title) {
      tl.fromTo(
        title,
        { clipPath: 'inset(0 0 100% 0)', y: 40 },
        { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.1 },
      );
    }

    // Settles back to 1 so the resting frame matches the Figma crop exactly.
    if (image) {
      tl.fromTo(image, { scale: 1.08 }, { scale: 1, duration: 1.6, ease: 'power2.out' }, 0);
    }

    if (lead.length) {
      tl.fromTo(
        lead,
        { opacity: 0, y: 24 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.08 },
        0.35,
      );
    }

    if (image) {
      gsap.to(image, {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
    }
  }
</script>

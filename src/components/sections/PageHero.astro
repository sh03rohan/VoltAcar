---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The inner-page hero: a full-bleed render behind a radial scrim, with a
 * heading and a lead paragraph placed off the frame's own coordinates.
 *
 * Every inner page in the Figma uses this same 1600x780 band and varies only
 * the render, the scrim, and where the copy block starts — so those are the
 * props. The Home hero (#13:82) keeps its own component: it carries a CTA and
 * the four-stat row, and its render is placed differently.
 *
 * Placement numbers come straight off the frame's image rect, as percentages
 * of the 1600x780 band. Rather than gate the exact crop behind a breakpoint,
 * the image carries a `min-height` equal to its own overhang, so it keeps the
 * frame's placement while the proportional crop still covers the band and
 * falls back to a `cover` fit once it no longer does.
 */
interface Props {
  /** Leading run of the heading. */
  title: string;
  /** Lime-highlighted run, rendered between `title` and `titleTrail`. */
  titleAccent?: string;
  titleTrail?: string;
  body?: string;
  image: ImageMetadata;
  /** Empty by default — the render is decoration behind the copy. */
  imageAlt?: string;
  /** The frame's radial scrim, as a full CSS background value. */
  scrim: string;
  /** Image rect as a share of the band: width, then its offsets. */
  imageWidth?: number;
  imageLeft?: number;
  imageTop?: number;
  /** Focal point once the band is too tall for the proportional crop. */
  imageFocus?: string;
  /** Copy block width and body width, in px, from the frame. */
  copyWidth?: number;
  bodyWidth?: number;
}

const {
  title,
  titleAccent,
  titleTrail,
  body,
  image,
  imageAlt = '',
  scrim,
  imageWidth = 100,
  imageLeft = 0,
  imageTop = 0,
  imageFocus = '60% 50%',
  copyWidth = 859,
  bodyWidth = 803,
} = Astro.props;

/* The render is wider than the band by design, so `100vw` would understate it
   and the browser would pick a variant it then has to rescale. Offering the
   frame's own pixel width as a candidate lets the desktop case decode 1:1. */
const naturalWidth = Math.round((1600 * imageWidth) / 100);
const widths = [...new Set([768, 1280, naturalWidth, 1920, 2400])].sort((a, b) => a - b);

const vars = {
  scrim,
  imgWidth: `${imageWidth}%`,
  imgLeft: `${imageLeft}%`,
  imgTop: `${imageTop}%`,
  /* Covers the band even where the proportional crop has become too short. */
  imgMinHeight: `${100 - imageTop}%`,
  imgFocus: imageFocus,
  copyWidth: `${copyWidth / 16}rem`,
  bodyWidth: `${bodyWidth / 16}rem`,
};
---

<section class="page-hero on-dark" data-page-hero>
  <div class="page-hero__media">
    <Image
      class="page-hero__image"
      src={image}
      alt={imageAlt}
      widths={widths}
      sizes={`${imageWidth}vw`}
      loading="eager"
      fetchpriority="high"
      data-page-hero-image
    />
    <div class="page-hero__scrim"></div>
  </div>

  <div class="page-hero__inner">
    <div class="page-hero__copy">
      <h1 class="page-hero__title" data-page-hero-title>
        {title}{titleAccent && <span class="page-hero__accent">{titleAccent}</span>}{titleTrail}
      </h1>
      {body && <p class="page-hero__lead" data-page-hero-lead>{body}</p>}
      <slot />
    </div>
  </div>
</section>

<style define:vars={vars}>
  .page-hero {
    position: relative;
    display: flex;
    min-height: var(--banner-h); /* 780 */
    color: var(--c-cream);
    background-color: var(--c-ink);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__image {
    position: absolute;
    top: var(--imgTop);
    left: var(--imgLeft);
    width: var(--imgWidth);
    height: auto;
    min-height: var(--imgMinHeight);
    max-width: none;
    object-fit: cover;
    object-position: var(--imgFocus);
  }

  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    /* Figma: the copy block starts 265px down. */
    padding: clamp(9rem, 6.5625rem + 10vw, 16.5625rem) var(--gutter) var(--sp-80);
  }

  .page-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-24);
    max-width: var(--copyWidth);
  }

  .page-hero__title {
    font-size: var(--fs-h1);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
  }

  .page-hero__accent {
    color: var(--c-primary);
  }

  .page-hero__lead {
    max-width: var(--bodyWidth);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }

  /* Once the band crops to `cover` the render drifts under the copy, so add a
     directional wash. The frame itself does not need one: there the copy sits
     over open floor. */
  @media (max-width: 1200px) {
    .page-hero__scrim {
      background:
        linear-gradient(
          to right,
          rgba(19, 20, 0, 0.72) 0%,
          rgba(19, 20, 0, 0.4) 50%,
          rgba(19, 20, 0, 0.05) 80%
        ),
        var(--scrim);
    }
  }

  @media (max-width: 768px) {
    .page-hero__scrim {
      background:
        linear-gradient(
          to bottom,
          rgba(19, 20, 0, 0.8) 0%,
          rgba(19, 20, 0, 0.5) 50%,
          rgba(19, 20, 0, 0.7) 100%
        ),
        var(--scrim);
    }

    .page-hero__lead {
      max-width: 30rem;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  const hero = document.querySelector<HTMLElement>('[data-page-hero]');

  if (hero && !prefersReducedMotion()) {
    const title = hero.querySelector('[data-page-hero-title]');
    const lead = hero.querySelector('[data-page-hero-lead]');
    const image = hero.querySelector<HTMLElement>('[data-page-hero-image]');

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    if (title) {
      tl.fromTo(
        title,
        { clipPath: 'inset(0 0 100% 0)', y: 40 },
        { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.1 },
      );
    }

    // Settles back to 1 so the resting frame matches the Figma crop exactly.
    if (image) {
      tl.fromTo(image, { scale: 1.08 }, { scale: 1, duration: 1.6, ease: 'power2.out' }, 0);
    }

    if (lead) {
      tl.fromTo(lead, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7 }, 0.35);
    }

    if (image) {
      gsap.to(image, {
        yPercent: 8,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: true },
      });
    }
  }
</script>

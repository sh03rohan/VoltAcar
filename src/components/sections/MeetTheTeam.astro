---
import { Image } from 'astro:assets';
import SocialIcon from '../common/SocialIcon.astro';
import TeamProfile from './TeamProfile.astro';
import { social } from '../../config/site';
import { team as members } from '../../data/team';

/**
 * "Meet Our Team" — Figma #103:189, with the revealed state taken from the
 * standalone #271:15877 where every card shows its overlay at once.
 *
 *   band    #FFFFFF, 180 of padding top and bottom
 *   header  #103:177  120 tall, space-between: a 64/1em heading at 445 and a
 *                     20/1.5 lead at 565
 *   gap     80
 *   grid    #103:188  two rows of three 445x560 lime cards, 32 apart
 *
 * Each card carries the role as vertical type at (24, 39), a cut-out portrait,
 * and a 405x228 cream detail card inset 20 from the card's left, right and
 * foot. The detail card is hidden until the member is hovered or focused —
 * the frame draws it on one card only, which is the design showing its hover
 * state rather than a card that differs.
 *
 * Card internals are sized in `cqw` against the card itself, so the whole
 * composition scales with the column instead of needing a breakpoint per
 * measurement. The card's fixed ratio means those units track its height too.
 *
 * Clicking a card opens that member's full-screen profile (TeamProfile). The
 * trigger is a transparent button laid over the card rather than a handler on
 * the card itself, so it is a real control for keyboard and assistive tech. It
 * sits above the portrait but below the detail card, which lets the social
 * links inside that card stay clickable.
 */
---

<section class="team" aria-labelledby="team-title">
  <div class="container">
    <div class="team__header">
      <h2 class="team__title" id="team-title">Meet Our Team</h2>
      <p class="team__lead">
        Meet the passionate minds driving innovation, safety, and sustainability in every electric
        journey.
      </p>
    </div>

    <ul class="team__grid" role="list">
      {
        members.map((member, i) => (
          <li class="member">
            <p class="member__role" aria-hidden="true">
              {member.role}
            </p>

            <Image
              class="member__photo"
              src={member.image}
              alt={member.alt}
              widths={[445, 668, 890]}
              sizes="(max-width: 600px) 88vw, (max-width: 992px) 44vw, 445px"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />

            <button class="member__open" type="button" data-tp-open={i}>
              <span class="visually-hidden">{`View ${member.name}’s profile`}</span>
            </button>

            <div class="member__card">
              <p class="member__name">{member.name}</p>
              {/* Carries the role for anyone not reading the vertical type. */}
              <p class="member__bio">
                <span class="visually-hidden">{member.role}. </span>
                {member.bio}
              </p>
              <ul class="member__social" role="list">
                {social.map((channel) => (
                  <li>
                    <a
                      class="member__link"
                      href={channel.href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      <SocialIcon name={channel.icon} />
                      <span class="visually-hidden">{`${member.name} on ${channel.label}`}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <TeamProfile />
</section>

<style>
  /* Figma: the band is white where the rest of the page is cream, and carries
     its own 180 top and bottom rather than relying on a section gap. */
  .team {
    padding-block: var(--section-gap);
    background-color: var(--c-white);
  }

  /* Fixed at 120, not a minimum: the 64px heading wraps to two lines (128) at
     its 445 measure and the frame lets it overflow, centred, into the 80 gap
     below — the same trick the Features slider header uses. */
  .team__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-48);
    height: 7.5rem;
    margin-bottom: var(--sp-80);
  }

  .team__title {
    max-width: 27.8125rem; /* 445 */
    font-size: var(--fs-h2); /* 64 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-ink);
  }

  .team__lead {
    max-width: 35.3125rem; /* 565 */
    font-size: var(--fs-lead); /* 20 */
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-32);
    margin: 0;
    padding: 0;
  }

  /* ---------- Card ---------- */

  .member {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 445 / 560;
    overflow: hidden;
    background-color: var(--c-primary);
  }

  /* Figma: 42x239 at (24, 39), reading bottom-to-top. `vertical-rl` alone
     reads top-to-bottom, so it is turned through 180. */
  .member__role {
    position: absolute;
    top: 8.764cqw; /* 39 */
    left: 5.393cqw; /* 24 */
    z-index: 2;
    /* Decorative and already announced by the profile trigger's label; letting
       it swallow clicks would punch a hole in the card's hit area. */
    pointer-events: none;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 7.191cqw; /* 32 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--c-ink);
    white-space: nowrap;
  }

  /* The cut-outs are composited to the card's own 445x560 window, so the
     frame's per-card offset is already baked in and this just fills. */
  .member__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Covers the whole card so anywhere on the portrait opens the profile. It
     carries no styling of its own — the card's appearance is unchanged. */
  .member__open {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  /* ---------- Detail card ---------- */

  .member__card {
    position: absolute;
    z-index: 4;
    right: 4.494cqw; /* 20 */
    bottom: 4.494cqw;
    left: 4.494cqw;
    display: flex;
    flex-direction: column;
    /* 228 when the bio runs to three lines, which is the frame's case; longer
       bios grow the card rather than being clipped by a fixed height. */
    min-height: 51.236cqw;
    padding: 5.393cqw; /* 24 */
    border-radius: var(--r-xs); /* 2 */
    background-color: var(--c-cream);
    color: var(--c-ink);

    opacity: 0;
    transform: translateY(8%);
    transition:
      opacity 0.32s ease,
      transform 0.32s ease;
    /* Invisible but still hit-testable, so at rest it would shadow the profile
       trigger across the bottom third of the card. It takes pointer events
       back only once it is actually on screen. */
    pointer-events: none;
  }

  /* Focus rather than focus-visible: the reveal has to happen for the social
     links inside, which are reachable by keyboard while the card is still at
     zero opacity. Opacity keeps them in the tab order — `visibility: hidden`
     would remove them and make the card unreachable without a pointer. */
  .member:hover .member__card,
  .member:focus-within .member__card {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .member__name {
    font-size: 5.393cqw; /* 24 */
    font-weight: var(--fw-semibold);
    line-height: var(--lh-body);
  }

  .member__bio {
    margin-top: 1.798cqw; /* 8 */
    margin-bottom: 7.191cqw; /* 32 */
    font-size: 3.596cqw; /* 16 */
    line-height: var(--lh-body);
  }

  .member__social {
    display: flex;
    gap: 3.146cqw; /* 14 */
    margin: auto 0 0;
    padding: 0;
  }

  .member__link {
    display: block;
    color: var(--c-ink);
    transition: color 0.2s ease;
  }

  .member__link :global(svg) {
    display: block;
    width: 7.191cqw; /* 32 */
    height: 7.191cqw;
  }

  /* The frame draws no hover for these, so it is chosen rather than measured.
     Steel is the design's usual accent but lands at 2.4:1 on cream — under the
     3:1 floor for graphics — so the state darkens instead of lightening. */
  .member__link:hover,
  .member__link:focus-visible {
    color: var(--c-muted);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 992px) {
    .team__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-24);
      height: auto;
      margin-bottom: var(--section-gap-sm);
    }

    .team__title,
    .team__lead {
      max-width: none;
    }

    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .team__grid {
      grid-template-columns: 1fr;
      /* One card per row is already a tall column; the cards do not also need
         the frame's full 445 measure to read. */
      max-width: 27.8125rem;
      margin-inline: auto;
    }
  }

  /* Without hover there is nothing to reveal the card with, and a tap would
     have to be spent on it, so it simply stays open. */
  @media (hover: none) {
    .member__card {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .member__card {
      transition-duration: 0.01ms;
      transform: none;
    }
  }
</style>

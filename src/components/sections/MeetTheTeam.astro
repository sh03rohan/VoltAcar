---
import { Image } from 'astro:assets';
import TeamProfile from './TeamProfile.astro';
import { team as members } from '../../data/team';

/**
 * "Meet Our Team" — Figma #103:189.
 *
 *   band    #FFFFFF, 180 of padding top and bottom
 *   header  #103:177  120 tall, space-between: a 64/1em heading at 445 and a
 *                     20/1.5 lead at 565
 *   gap     80
 *   grid    #103:188  two rows of three 445x560 lime cards, 32 apart
 *
 * Each card is the role as vertical type at (24, 39) over a cut-out portrait.
 * Card internals are sized in `cqw` against the card itself, so the whole
 * composition scales with the column instead of needing a breakpoint per
 * measurement. The card's fixed ratio means those units track its height too.
 *
 * The frame also draws a 405x228 cream detail card on hover, carrying the
 * name, bio and social links. That is deliberately not built: the same
 * information — and more of it — now belongs to the full-screen profile, so
 * showing it twice would only compete with itself. Clicking anywhere on a card
 * opens that member's profile (TeamProfile) instead.
 *
 * The trigger is a transparent button laid over the card rather than a handler
 * on the card itself, so it is a real control for keyboard and assistive tech.
 */
---

<section class="team" aria-labelledby="team-title">
  <div class="container">
    <div class="team__header">
      <h2 class="team__title" id="team-title">Meet Our Team</h2>
      <p class="team__lead">
        Meet the passionate minds driving innovation, safety, and sustainability in every electric
        journey.
      </p>
    </div>

    <ul class="team__grid" role="list">
      {
        members.map((member, i) => (
          <li class="member">
            <p class="member__role" aria-hidden="true">
              {member.role}
            </p>

            <Image
              class="member__photo"
              src={member.image}
              alt={member.alt}
              widths={[445, 668, 890]}
              sizes="(max-width: 600px) 88vw, (max-width: 992px) 44vw, 445px"
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />

            {/* The label carries the role too, since the vertical type is
                decorative and hidden from assistive tech. */}
            <button class="member__open" type="button" data-tp-open={i}>
              <span class="visually-hidden">
                {`View ${member.name}’s profile — ${member.role}`}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <TeamProfile />
</section>

<style>
  /* Figma: the band is white where the rest of the page is cream, and carries
     its own 180 top and bottom rather than relying on a section gap. */
  .team {
    padding-block: var(--section-gap);
    background-color: var(--c-white);
  }

  /* Fixed at 120, not a minimum: the 64px heading wraps to two lines (128) at
     its 445 measure and the frame lets it overflow, centred, into the 80 gap
     below — the same trick the Features slider header uses. */
  .team__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-48);
    height: 7.5rem;
    margin-bottom: var(--sp-80);
  }

  .team__title {
    max-width: 27.8125rem; /* 445 */
    font-size: var(--fs-h2); /* 64 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-ink);
  }

  .team__lead {
    max-width: 35.3125rem; /* 565 */
    font-size: var(--fs-lead); /* 20 */
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-32);
    margin: 0;
    padding: 0;
  }

  /* ---------- Card ---------- */

  .member {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 445 / 560;
    overflow: hidden;
    background-color: var(--c-primary);
  }

  /* Figma: 42x239 at (24, 39), reading bottom-to-top. `vertical-rl` alone
     reads top-to-bottom, so it is turned through 180. */
  .member__role {
    position: absolute;
    top: 8.764cqw; /* 39 */
    left: 5.393cqw; /* 24 */
    z-index: 2;
    /* Decorative and already announced by the profile trigger's label; letting
       it swallow clicks would punch a hole in the card's hit area. */
    pointer-events: none;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 7.191cqw; /* 32 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--c-ink);
    white-space: nowrap;
  }

  /* The cut-outs are composited to the card's own 445x560 window, so the
     frame's per-card offset is already baked in and this just fills. */
  .member__photo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* With the detail card gone, nothing but the cursor said these were
     clickable. The portrait leans forward instead — enough to read as a
     control, small enough to leave the composition alone. */
  .member:hover .member__photo,
  .member:focus-within .member__photo {
    transform: scale(1.035);
  }

  @media (prefers-reduced-motion: reduce) {
    .member__photo {
      transition: none;
    }

    .member:hover .member__photo,
    .member:focus-within .member__photo {
      transform: none;
    }
  }

  /* Covers the whole card so anywhere on the portrait opens the profile. It
     carries no styling of its own — the card's appearance is unchanged. */
  .member__open {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 992px) {
    .team__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-24);
      height: auto;
      margin-bottom: var(--section-gap-sm);
    }

    .team__title,
    .team__lead {
      max-width: none;
    }

    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .team__grid {
      grid-template-columns: 1fr;
      /* One card per row is already a tall column; the cards do not also need
         the frame's full 445 measure to read. */
      max-width: 27.8125rem;
      margin-inline: auto;
    }
  }
</style>

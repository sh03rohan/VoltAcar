---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Charging CTA banner — the card the Figma repeats across the site: a
 * full-bleed render under a radial scrim with a 64px two-tone heading and a
 * short body.
 *
 * Sizing and copy placement are separate axes, because the frames mix them:
 *   layout  panel — a full-viewport slide inside CtaSlider
 *           band  — the frame's own 1600x780 proportions, standalone
 *   align   split — heading and body at opposite ends of the 620 copy frame
 *                   (#37:40, #55:139, #55:91, #143:729, #143:737)
 *           foot  — both at its foot, 32 apart (#128:429)
 *
 * Either way the copy frame is 807x620 at (100, 80): the full height less the
 * 80 padding top and bottom.
 */
interface Props {
  /** Runs before the accent. */
  title: string;
  /** The lime run. On Home it is the whole second line. */
  titleAccent?: string;
  /** Runs after the accent — Features carries the heading past the break. */
  titleTrail?: string;
  /** Home's cards break hard after `title`; Features wraps naturally. */
  breakAfterTitle?: boolean;
  body: string;
  image: ImageMetadata;
  alt: string;
  /** The card's radial scrim, taken from its Figma fill. */
  scrim: string;
  /** Focal point for the `cover` fit. */
  focus?: string;
  layout?: 'panel' | 'band';
  /** Where the copy sits inside the 620 frame. */
  align?: 'split' | 'foot';
  /** Measures in px from the frame's text boxes. */
  titleWidth?: number;
  bodyWidth?: number;
  eager?: boolean;
  /** Position announcement when the banner is one slide of a carousel. */
  label?: string;
}

const {
  title,
  titleAccent,
  titleTrail,
  breakAfterTitle = false,
  body,
  image,
  alt,
  scrim,
  focus = '85% center',
  layout = 'panel',
  align = 'split',
  titleWidth = 807,
  bodyWidth = 326,
  eager = false,
  label,
} = Astro.props;
---

<article
  class:list={['panel', 'on-dark', `panel--${layout}`, `panel--${align}`]}
  data-cta-panel
  aria-label={label}
  style={`--panel-title-width:${titleWidth / 16}rem;--panel-body-width:${bodyWidth / 16}rem`}
>
  <Image
    src={image}
    alt={alt}
    widths={[768, 1280, 1600, 2000]}
    sizes="100vw"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="panel__bg"
    style={`object-position:${focus}`}
  />
  <div class="panel__scrim" style={`background:${scrim}`}></div>

  <div class="panel__content">
    <h2 class="panel__title">
      {title}{breakAfterTitle && <br />}{titleAccent && (
        <span class="panel__accent">{titleAccent}</span>
      )}{titleTrail}
    </h2>
    <p class="panel__body">{body}</p>
  </div>
</article>

<style>
  .panel {
    position: relative;
    flex: none;
    overflow: hidden;
    isolation: isolate;
  }

  /* Home: one slide of the pinned slider. */
  .panel--panel {
    width: 100vw;
    height: 100svh;
    /* The Figma card is 1600x780; keep it from becoming a letterbox strip on
       short landscape viewports. */
    min-height: 34rem;
  }

  /* Features: the frame's own band. */
  .panel--band {
    width: 100%;
    aspect-ratio: 1600 / 780;
    min-height: 30rem;
  }

  .panel__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Figma: the copy block sits at (100, 80) and is 620 tall. */
  .panel__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--sp-80) var(--gutter);
  }

  .panel--split .panel__content {
    justify-content: space-between;
  }

  .panel--foot .panel__content {
    justify-content: flex-end;
    gap: var(--sp-32);
  }

  .panel__title {
    max-width: var(--panel-title-width);
    font-size: var(--fs-h2); /* 64 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--c-cream);
  }

  .panel__accent {
    color: var(--c-primary);
  }

  .panel__body {
    max-width: var(--panel-body-width);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-cream);
  }

  /* The panel fills the viewport, so the pinned header sits over its top
     edge. At desktop the design's 80px padding already clears an 80px header;
     below that the header stays 64px while the padding would shrink, so the
     heading has to be pushed clear explicitly. */
  @media (max-width: 1100px) {
    .panel--panel .panel__content {
      padding-top: calc(var(--header-h) + var(--sp-24));
    }
  }

  @media (max-width: 768px) {
    .panel__content {
      padding-bottom: var(--sp-48);
    }

    .panel__body {
      max-width: 26rem;
    }

    /* A 2.05 band is too shallow for a 36px heading plus body once the
       gutters close in. */
    .panel--band {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }
  }

  /* On a narrow portrait panel the 36px floor of --fs-h2 runs the second
     heading line into the gutter, so it scales with the viewport instead. */
  @media (max-width: 600px) {
    .panel__title {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    /* Portrait crops horizontally; ease off the right bias so the car is not
       reduced to its rear quarter. */
    .panel__bg {
      object-position: 72% center !important;
    }
  }
</style>

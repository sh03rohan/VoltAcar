---
import Button from '../common/Button.astro';

/**
 * Home mission band — Figma #69:316.
 *
 * A 1400px row, bottom-aligned: a 326px grey note on the left, then a 151px
 * gap, then a 923px column holding the 36px statement and the dark CTA.
 */
const statement =
  'We’re creating the next generation of electric mobility — crafted for modern cities, everyday lives, and a cleaner tomorrow. Our mission is simple: to make electric driving accessible, efficient, and truly human-centered.';

const note =
  'We are building the next generation of electric mobility — designed for modern cities, everyday people';
---

<section class="mission" data-mission>
  <div class="mission__inner">
    <p class="mission__note" data-mission-note>{note}</p>

    <div class="mission__main">
      <p class="mission__statement" data-mission-statement>{statement}</p>
      <div class="mission__cta" data-mission-cta>
        <Button label="Take a Test Drive" href="/test-drive" variant="dark" />
      </div>
    </div>
  </div>
</section>

<style>
  .mission {
    /* Figma: band sits 120px below the hero, 168px above the next section. */
    padding-block: clamp(3.5rem, 1.9rem + 7.1vw, 7.5rem)
      clamp(4rem, 1.6rem + 10.7vw, 10.5rem);
  }

  .mission__inner {
    display: flex;
    align-items: flex-end;
    gap: 9.4375rem; /* 151 */
    width: 100%;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .mission__note {
    flex: 0 0 20.375rem; /* 326 */
    width: 20.375rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  .mission__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-48);
    flex: 0 1 57.6875rem; /* 923 */
    width: 57.6875rem;
  }

  .mission__statement {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-ink);

    /* Revealed by wiping this soft-edged mask across the text. Doing it with
       a mask rather than per-word spans keeps the text a single flow, so it
       still breaks at hyphens exactly as the design does and long words in
       CMS copy can still wrap. Defaults to fully visible without JS. */
    --reveal: 120%;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0%,
      #000 var(--reveal),
      transparent calc(var(--reveal) + 14%)
    );
    mask-image: linear-gradient(
      to right,
      #000 0%,
      #000 var(--reveal),
      transparent calc(var(--reveal) + 14%)
    );
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1400px) {
    .mission__inner {
      gap: var(--sp-80);
    }

    .mission__note {
      flex: 0 1 20.375rem;
    }

    .mission__main {
      flex: 1 1 auto;
      width: auto;
    }
  }

  /* The side note is supporting copy — below the two-column threshold it
     reads better above the statement than squeezed beside it. */
  @media (max-width: 992px) {
    .mission__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-32);
    }

    .mission__note {
      order: -1;
      flex: none;
      width: 100%;
      max-width: 34rem;
    }

    .mission__main {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .mission__main {
      gap: var(--sp-32);
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-mission]');

  if (section && !prefersReducedMotion()) {
    const statement = section.querySelector<HTMLElement>('[data-mission-statement]');
    const note = section.querySelector('[data-mission-note]');
    const cta = section.querySelector('[data-mission-cta]');

    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: { trigger: section, start: 'top 75%', once: true },
    });

    if (note) tl.fromTo(note, { opacity: 0, x: -16 }, { opacity: 1, x: 0, duration: 0.7 }, 0);

    // Wipe the mask across the statement instead of fading the block.
    if (statement) {
      tl.fromTo(
        statement,
        { '--reveal': '-14%' },
        { '--reveal': '120%', duration: 1.4, ease: 'power2.inOut' },
        0.1,
      );
    }

    if (cta) tl.fromTo(cta, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6 }, '>-0.5');
  }
</script>

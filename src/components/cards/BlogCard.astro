---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../common/Icon.astro';

/**
 * Article row — Figma #237:868 and siblings on the blog listing, reused for
 * "Similar Blog" on the single post (#263:982, #263:995).
 *
 *   row     padding 32 0, gap 148, centred, 0.5px #84A2BA under it
 *   media   565x340, radius 4
 *   copy    687 wide, stretched to the row and split top-and-bottom: the
 *           title and standfirst 16 apart at the top, the pill at the foot
 *
 * 565 + 148 + 687 is exactly the 1400 container.
 *
 * The whole row is one link: the title carries it and a stretched
 * pseudo-element covers the row, so there is a single tab stop whose
 * accessible name is the post title. The "Read more" pill is deliberately not
 * a second link to the same place — it is a span, which is also why it does
 * not reuse Button. At 32px tall around a 24px circle, on cream that matches
 * the page, it shares almost nothing with that component but the idea.
 */
interface Props {
  title: string;
  description: string;
  href: string;
  cover: ImageMetadata;
  coverAlt?: string;
  /** Set on the first row of a page so its render is not lazy-loaded. */
  eager?: boolean;
}

const { title, description, href, cover, coverAlt = '', eager = false } = Astro.props;
---

<article class="post">
  <div class="post__media">
    <Image
      class="post__image"
      src={cover}
      alt={coverAlt}
      widths={[400, 565, 848, 1130]}
      sizes="(max-width: 992px) 92vw, 565px"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>

  <div class="post__copy">
    <div class="post__text">
      <h3 class="post__title">
        <a class="post__link" href={href}>{title}</a>
      </h3>
      <p class="post__excerpt">{description}</p>
    </div>

    <span class="post__more">
      Read more
      <span class="post__more-icon"><Icon name="arrow" size={16} /></span>
    </span>
  </div>
</article>

<style>
  .post {
    position: relative;
    display: flex;
    align-items: center;
    /* 148 / 1400 */
    gap: 10.571%;
    padding-block: var(--sp-32);
  }

  /* The rule is drawn rather than bordered: Figma strokes sit inside the
     frame, so a real border-bottom adds its 0.5px to the row's 404 and the
     error compounds down a six-row list. */
  .post::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 0.5px;
    background-color: var(--c-steel);
  }

  /* 565 / 1400, holding the frame's card ratio. */
  .post__media {
    flex: 0 0 40.357%;
    aspect-ratio: 565 / 340;
    border-radius: var(--r-sm);
    background-color: var(--c-white);
    overflow: hidden;
  }

  .post__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* 687 / 1400. Stretched to the media's height and split, which is what puts
     the pill on the row's baseline rather than under the standfirst. */
  .post__copy {
    display: flex;
    flex: 0 0 49.071%;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
  }

  .post__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
  }

  /* The frame sets this box to 476 on the first row and lets the other five
     fill all 687 — an override with no counterpart in content, so it cannot
     come from the collection. What the frame actually renders is six two-line
     headings, and a single 600 measure reproduces that: it is under the first
     title's 614px natural width, so that one breaks, and wide enough that the
     longest still fits two lines. It is also a saner heading measure than 687
     for titles a buyer will write themselves. */
  .post__title {
    max-width: 37.5rem; /* 600 */
    font-size: var(--fs-h4); /* 36 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--c-ink);
  }

  .post__link {
    color: inherit;
    text-decoration: none;
  }

  /* Hover sweeps a colour across the title rather than underlining it. The
     gradient is two flat halves on a box twice the text's width, so sliding
     its position wipes the new colour in from the left — the motion a GSAP
     tween of `backgroundPosition` produces, without a listener per card, and
     it still runs if the JS never arrives.

     The fill is --c-muted: it is the only palette colour that both differs
     from ink and stays legible on cream, at 4.62:1. Brand yellow measures
     1.01:1 there and steel 2.41:1, so both fail even the 3:1 floor a 36px
     bold heading gets.

     Guarded, because the technique needs transparent text: without the
     support the title would be invisible rather than merely unanimated. */
  /* `.post__line` is created by the script, so it never carries this
     component's scope attribute and can only be reached with `:global()`.
     Written plainly it matches nothing — and since the fill needs transparent
     text, that leaves the title invisible rather than merely unanimated.
     Nested under `.post__link`, which is server-rendered and does carry the
     scope, so nothing leaks past this card. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .post__link,
    .post__link :global(.post__line) {
      background-image: linear-gradient(
        to right,
        var(--c-muted) 50%,
        var(--c-ink) 50%
      );
      background-size: 200% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
      transition: background-position 0.5s cubic-bezier(0.33, 1, 0.68, 1);
    }

    /* Without JS the link is one box; a cloned decoration still gives each
       line its own gradient so they fill together rather than sharing one
       sweep the shorter line finishes early. */
    .post__link {
      display: inline;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    /* Once the script has split the title, the lines carry the fill and the
       link must stop painting its own over the top of them. */
    .post__link.is-split {
      background-image: none;
    }

    /* Each line waits for the one above it, so a two-line title fills top
       then bottom instead of both at once. */
    .post__link :global(.post__line) {
      transition-delay: calc(var(--line) * 0.16s);
    }

    .post:hover .post__link,
    .post:hover .post__link :global(.post__line),
    .post__link:focus-visible,
    .post__link:focus-visible :global(.post__line) {
      background-position: 0 0;
    }
  }

  /* Carries the click for the whole row, so the pill and the render are both
     live without being separate tab stops. */
  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post__excerpt {
    font-size: var(--fs-lead); /* 20 */
    line-height: var(--lh-body);
    color: var(--c-muted);
  }

  /* Figma #237:875: padding 4/4/4/8, gap 12, on #F4F3EF — the page's own
     colour, so only the lime circle reads. */
  .post__more {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: var(--sp-12);
    padding: 4px 4px 4px var(--sp-8);
    border-radius: var(--r-pill);
    background-color: var(--c-cream);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .post__more-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    background-color: var(--c-primary);
    color: var(--c-ink);
    transition: transform 0.25s var(--ease-out, ease);
  }

  /* ---------- Hover / focus ---------- */

  @media (hover: hover) {
    .post:hover .post__image {
      transform: scale(1.04);
    }

    .post:hover .post__more-icon {
      transform: translateX(3px);
    }
  }

  /* ---------- Responsive ---------- */

  /* The 148 gap is a tenth of the row; once the columns tighten it buys
     nothing, so it collapses before the layout does. */
  @media (max-width: 1200px) {
    .post {
      gap: var(--sp-48);
    }

    .post__media {
      flex: 0 0 42%;
    }

    .post__copy {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 992px) {
    .post {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-24);
    }

    .post__media {
      flex: none;
    }

    .post__copy {
      gap: var(--sp-24);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post__image,
    .post__more-icon,
    .post__link,
    .post__link :global(.post__line) {
      transition: none;
    }

    /* The stagger is the animation; without it the lines change together. */
    .post__link :global(.post__line) {
      transition-delay: 0s;
    }

    .post:hover .post__image {
      transform: none;
    }
  }
</style>

<script>
  /**
   * Splits each card title into one span per rendered line so the hover fill
   * can run down them in order. CSS cannot stagger line fragments — they are
   * not elements — and this is the same thing GSAP's SplitText does.
   *
   * Words are wrapped first and grouped by their measured top, so the split
   * follows the browser's own line breaking rather than guessing at it. The
   * spans stay `inline` and keep the spaces between them, so re-laying out
   * the split title breaks in exactly the same places.
   *
   * No-JS, and the interval between splitting and this running, both fall
   * back to the CSS rule on the link itself: the fill still works, it just
   * arrives on every line at once.
   */
  const titles = document.querySelectorAll<HTMLElement>('.post__link');

  function splitIntoLines(link: HTMLElement, text: string): void {
    // Wrap every word, leaving the whitespace untouched so wrapping is
    // unaffected by the measurement pass itself.
    link.innerHTML = text
      .split(/(\s+)/)
      .map((chunk) => (/^\s+$/.test(chunk) || chunk === '' ? chunk : `<span>${chunk}</span>`))
      .join('');

    const words = [...link.querySelectorAll('span')];
    if (words.length === 0) return;

    const lines: string[][] = [];
    let lastTop: number | null = null;

    for (const word of words) {
      const top = Math.round(word.getBoundingClientRect().top);
      if (lastTop === null || Math.abs(top - lastTop) > 2) {
        lines.push([]);
        lastTop = top;
      }
      lines[lines.length - 1].push(word.textContent ?? '');
    }

    link.innerHTML = lines
      .map((words_, i) => `<span class="post__line" style="--line:${i}">${words_.join(' ')}</span>`)
      .join(' ');
    link.classList.add('is-split');
  }

  function run(): void {
    titles.forEach((link) => {
      const text = link.dataset.text ?? link.textContent?.trim() ?? '';
      if (!link.dataset.text) link.dataset.text = text;
      link.classList.remove('is-split');
      splitIntoLines(link, text);
    });
  }

  if (titles.length) {
    // After the webfont lands, or the measurement is of fallback metrics and
    // the lines come out in the wrong places.
    void document.fonts.ready.then(run);

    // Line count changes with the column, so the split has to be redone.
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(run, 150);
    });
  }
</script>

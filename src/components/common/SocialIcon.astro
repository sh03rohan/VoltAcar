---
/**
 * Brand glyphs for the footer's social row (Figma #158:1003).
 *
 * Kept apart from Icon.astro because these are filled 32x32 paths while that
 * set is stroked geometry on a 20x20 grid. Exported straight from the Figma
 * nodes with their hard-coded fills swapped for `currentColor`.
 *
 * `x` is the current Twitter/X mark. The design labels that link "Twitter"
 * while drawing the X glyph, and both are reproduced as-is.
 */
export type SocialIconName = 'instagram' | 'facebook' | 'x' | 'youtube';

interface Props {
  name: SocialIconName;
  size?: number;
  class?: string;
}

const { name, size = 32, class: className } = Astro.props;
---


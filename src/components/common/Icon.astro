---
/**
 * Inline icon set.
 *
 * The `arrow` and `chevron` paths are the exact geometry exported from Figma
 * (nodes #15:110 and #266:204); they are inlined rather than referenced as
 * files so they can inherit `currentColor` and be animated.
 */
interface Props {
  name: 'arrow' | 'chevron' | 'menu' | 'close' | 'plus';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'arrow' && (
      <>
        <path d="M3.5 10h13" />
        <path d="M10 3.5 16.5 10 10 16.5" />
      </>
    )
  }
  {name === 'chevron' && <path d="M5 7.5 10 12.5 15 7.5" />}
  {
    name === 'plus' && (
      <>
        <path d="M4.167 10h11.666" />
        <path d="M10 4.167v11.666" />
      </>
    )
  }
  {
    name === 'menu' && (
      <>
        <path d="M3 6h14" />
        <path d="M3 10h14" />
        <path d="M3 14h14" />
      </>
    )
  }
  {
    name === 'close' && (
      <>
        <path d="M5 5l10 10" />
        <path d="M15 5 5 15" />
      </>
    )
  }
</svg>

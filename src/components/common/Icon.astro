---
/**
 * Inline icon set.
 *
 * The `arrow` and `chevron` paths are the exact geometry exported from Figma
 * (nodes #15:110 and #266:204); they are inlined rather than referenced as
 * files so they can inherit `currentColor` and be animated.
 */
interface Props {
  name:
    | 'arrow'
    | 'chevron'
    | 'menu'
    | 'close'
    | 'plus'
    | 'calendar'
    | 'check'
    | 'reset'
    | 'drag';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

/* `calendar` is Figma #258:251 traced at its own 24 grid; redrawing it on 20
   would move every dot off a whole pixel. */
const viewBox = name === 'calendar' ? '0 0 24 24' : '0 0 20 20';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'arrow' && (
      <>
        <path d="M3.5 10h13" />
        <path d="M10 3.5 16.5 10 10 16.5" />
      </>
    )
  }
  {name === 'chevron' && <path d="M5 7.5 10 12.5 15 7.5" />}
  {name === 'check' && <path d="M4.5 10.5 8 14l7.5-8" />}
  {
    /* A circular arrow — "return this to where it started". */
    name === 'reset' && (
      <>
        <path d="M3.6 10a6.4 6.4 0 1 0 1.9-4.5" />
        <path d="M3.2 3.2v3.4h3.4" />
      </>
    )
  }
  {
    /* A hand with a motion arc, matching the drag hint in the design. */
    name === 'drag' && (
      <>
        <path d="M8 9.2V4.6a1.2 1.2 0 0 1 2.4 0v4.1" />
        <path d="M10.4 8.8V7.6a1.2 1.2 0 0 1 2.4 0v1.4" />
        <path d="M12.8 9.2V8.4a1.2 1.2 0 0 1 2.4 0V13a4 4 0 0 1-4 4H10a3 3 0 0 1-2.3-1.1L5.2 13a1.2 1.2 0 0 1 1.7-1.7L8 12.4" />
      </>
    )
  }
  {
    name === 'calendar' && (
      <>
        <path d="M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7Z" />
        <path d="M16 3v4" />
        <path d="M8 3v4" />
        <path d="M4 11h16" />
        <path d="M7 14h.013" />
        <path d="M10.01 14h.005" />
        <path d="M13.01 14h.005" />
        <path d="M16.016 14h.005" />
        <path d="M7.01 17h.005" />
        <path d="M10.01 17h.005" />
        <path d="M13.016 17h.005" />
      </>
    )
  }
  {
    name === 'plus' && (
      <>
        <path d="M4.167 10h11.666" />
        <path d="M10 4.167v11.666" />
      </>
    )
  }
  {
    name === 'menu' && (
      <>
        <path d="M3 6h14" />
        <path d="M3 10h14" />
        <path d="M3 14h14" />
      </>
    )
  }
  {
    name === 'close' && (
      <>
        <path d="M5 5l10 10" />
        <path d="M15 5 5 15" />
      </>
    )
  }
</svg>

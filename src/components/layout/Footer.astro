---
import SocialIcon from '../common/SocialIcon.astro';
import { contact, footerColumns, site, social } from '../../config/site';

/**
 * Site footer — Figma #91:594, 1600x1075, on every page.
 *
 * Two stacked bands:
 *   ink   0–683    the contact block (#91:598) at (100, 120), 1400x403, its
 *                  top row and link row pushed to opposite ends
 *   lime  683–1075 the oversized wordmark (#91:596), 344 Bold at -0.04em
 *
 * Measured off the frame render:
 *   address   32 / 1.3, 446 wide, two lines, white
 *   socials   four 32px glyphs 14 apart, starting flush with the container
 *   email     64 / 1em at x=814 — the contact column is a fixed 686, so it is
 *   phone     sized rather than pushed right, which would land it at 902
 *   links     three 214 columns, 32 apart, flush with the container's right
 *   wordmark  cap top 60 below the lime edge, baseline 76 above the bottom
 *
 * The wordmark is sized in `cqw` against the container so it spans it exactly
 * at any width. A brand name longer than "VoltACar" needs that ratio dropped.
 */
const isExternal = (href: string): boolean => /^https?:/.test(href);
---

<footer class="footer on-dark">
  <div class="container footer__inner">
    <div class="footer__body">
      <div class="footer__top">
        <div class="footer__brand" data-animate>
          <address class="footer__address">{contact.address}</address>

          <ul class="footer__social" role="list">
            {
              social.map((item) => (
                <li>
                  <a
                    class="footer__social-link"
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <SocialIcon name={item.icon} />
                    <span class="visually-hidden">{item.label} (opens in a new tab)</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="footer__contact" data-animate data-animate-delay="0.1">
          <a class="footer__contact-link" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
          <a class="footer__contact-link" href={`tel:${contact.phoneHref}`}>
            {contact.phone}
          </a>
        </div>
      </div>

      <nav class="footer__nav" aria-label={`${site.name} footer`} data-animate data-animate-delay="0.2">
        {
          footerColumns.map((column) => (
            <ul class="footer__column" role="list">
              {column.map((link) => (
                <li>
                  <a
                    class="footer__link"
                    href={link.href}
                    target={isExternal(link.href) ? '_blank' : undefined}
                    rel={isExternal(link.href) ? 'noreferrer' : undefined}
                  >
                    {link.label}
                    {isExternal(link.href) && (
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </nav>
    </div>
  </div>

  <div class="footer__mark" aria-hidden="true">
    <div class="container footer__mark-inner" data-footer-mark>
      <span class="footer__mark-text" data-footer-mark-text>{site.name}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--c-ink);
    color: var(--c-white);
  }

  /* 120 above the block, 160 between it and the lime band. Scoped to its own
     class, not `.footer .container` — the wordmark wrapper is a .container too
     and would inherit both. */
  .footer__inner {
    padding-top: clamp(3rem, 1.55rem + 5.95vw, 7.5rem);
    padding-bottom: clamp(4rem, 2.07rem + 7.93vw, 10rem);
  }

  /* The frame's 403 is what separates the contact row from the links; below
     that height the two rows simply sit `gap` apart. */
  .footer__body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-48);
    min-height: 25.1875rem; /* 403 */
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-48);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--sp-48);
    align-items: flex-start;
  }

  .footer__address {
    max-width: 27.875rem; /* 446 — holds the designed two-line break */
    font-size: var(--fs-h5); /* 32 */
    font-style: normal;
    line-height: var(--lh-heading);
  }

  .footer__social {
    display: flex;
    gap: var(--sp-14);
    margin: 0;
    padding: 0;
  }

  .footer__social-link {
    display: block;
    color: var(--c-white);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--c-primary);
  }

  /* Fixed at the frame's 686 rather than pushed right: the column is wider
     than its text, so right-alignment would move the email 88px out. */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 2.625rem; /* 42 */
    flex: 0 0 49%; /* 686 / 1400 */
  }

  .footer__contact-link {
    font-size: var(--fs-h2); /* 64 */
    line-height: var(--lh-tight);
    transition: color var(--dur-fast) var(--ease-out);
    /* Long addresses break rather than widening the page. */
    overflow-wrap: break-word;
  }

  .footer__contact-link:hover {
    color: var(--c-primary);
  }

  .footer__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--sp-32);
  }

  /* The line height has to sit on the list, not the link: an inline <a> cannot
     shrink the line box its <li> strut already established, so a 1.3 link
     inside a 1.5 item still measures 24 and the rows drift 3px apart. */
  .footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    flex: 0 0 13.375rem; /* 214 */
    margin: 0;
    padding: 0;
    line-height: var(--lh-heading);
  }

  .footer__link {
    font-size: var(--fs-body);
    /* The Figma sets these nodes to title case, which is what turns
       "About us" into "About Us" and "404 error" into "404 Error". */
    text-transform: capitalize;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--c-primary);
  }

  /* ---------- Wordmark band ------------------------------------------------
     Everything here is a share of the container's inline size, so the band
     keeps the frame's proportions at any width: 0.286 + 24.571 + 3.143 = 28cqw
     of 1400 is the frame's 392, and lands the cap 60 below the lime edge with
     the baseline 76 above the bottom. */
  .footer__mark {
    background-color: var(--c-primary);
    color: var(--c-ink);
    overflow: hidden;
  }

  .footer__mark-inner {
    container-type: inline-size;
    overflow: hidden;
  }

  /* The paddings live here rather than on the wrapper: `cqw` inside the query
     container itself resolves against the viewport, not the container. */
  .footer__mark-text {
    display: block;
    /* The frame hangs the text box 3px left of the container so the V's side
       bearing does not read as an indent against the copy above. */
    margin-left: -0.214cqw; /* -3 */
    padding-top: 0.286cqw; /* 4 */
    padding-bottom: 3.143cqw; /* 44 */
    font-size: 24.571cqw; /* 344 */
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  /* ---------- Responsive --------------------------------------------------- */

  /* The 686 contact column and the right-aligned link row both stop earning
     their keep once the frame's proportions are gone. */
  @media (max-width: 1100px) {
    .footer__body {
      min-height: 0;
      gap: var(--sp-80);
    }

    .footer__top {
      flex-direction: column;
      gap: var(--sp-48);
    }

    .footer__contact {
      flex: none;
    }

    .footer__nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .footer__nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-32);
    }

    .footer__column {
      flex: none;
    }

    /* An email is one unbreakable word, so below this width --fs-h2's floor
       is wider than the gutters leave and it breaks mid-address. This curve
       meets --fs-h2 exactly at 768 and keeps it on one line down to 320. */
    .footer__contact-link {
      font-size: clamp(1.75rem, 0.381rem + 5.873vw, 3.2rem);
    }
  }
</style>

<script>
  import { revealOnScroll, gsap, prefersReducedMotion } from '../../scripts/motion';

  const footer = document.querySelector<HTMLElement>('.footer');
  if (footer) {
    revealOnScroll(footer);

    /* The wordmark wipes up from the lime band's own bottom edge — the band
       clips it, so nothing shows above or below the crop. */
    const text = footer.querySelector<HTMLElement>('[data-footer-mark-text]');
    const mark = footer.querySelector<HTMLElement>('[data-footer-mark]');
    if (text && mark && !prefersReducedMotion()) {
      gsap.fromTo(
        text,
        { yPercent: 105 },
        {
          yPercent: 0,
          duration: 1.1,
          ease: 'expo.out',
          scrollTrigger: { trigger: mark, start: 'top 95%', once: true },
        },
      );
    }
  }
</script>

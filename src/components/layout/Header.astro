---
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import { navigation, site } from '../../config/site';

/**
 * Site header — Figma #266:194 (and its per-page twins #266:15757, #266:15777,
 * #266:15797, #266:15817, #266:15837, #266:15857, which are identical).
 *
 * Sits 24px from the top of the page, 1400px wide, overlaying the dark hero.
 * Layout is space-between: wordmark / nav / CTA. Nav links are 16px Medium
 * with 32px gaps; the current page is lime, the rest cream.
 */
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isCurrent = (href: string): boolean =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const isBranchCurrent = (link: (typeof navigation)[number]): boolean =>
  link.children
    ? link.children.some((child) => child.href !== '/404' && isCurrent(child.href))
    : isCurrent(link.href);
---

<header class="header on-dark" data-header>
  <div class="header__inner">
    <a class="header__logo" href="/" aria-label={`${site.name} — home`}>
      {site.name}
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="nav" role="list">
        {
          navigation.map((link) =>
            link.children ? (
              <li class="nav__item nav__item--has-menu">
                <button
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-dropdown-trigger
                  class:list={[
                    'nav__link',
                    'nav__trigger',
                    isBranchCurrent(link) && 'is-current',
                  ]}
                >
                  {link.label}
                  <Icon name="chevron" size={20} class="nav__chevron" />
                </button>
                <ul class="dropdown" role="list" data-dropdown>
                  {link.children.map((child) => (
                    <li>
                      <a
                        class:list={[
                          'dropdown__link',
                          isCurrent(child.href) && 'is-current',
                        ]}
                        href={child.href}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  class:list={['nav__link', isCurrent(link.href) && 'is-current']}
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="header__cta">
      <Button label="Take a Test Drive" href="/test-drive" variant="light" />
    </div>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-drawer-toggle
    >
      <span class="visually-hidden">Open menu</span>
      <Icon name="menu" size={24} />
    </button>
  </div>

  <!-- Mobile drawer -->
  <div class="drawer" id="mobile-nav" data-drawer hidden>
    <div class="drawer__panel">
      <div class="drawer__head">
        <a class="header__logo" href="/">{site.name}</a>
        <button type="button" class="drawer__close" data-drawer-close>
          <span class="visually-hidden">Close menu</span>
          <Icon name="close" size={24} />
        </button>
      </div>

      <nav aria-label="Mobile">
        <ul class="drawer__nav" role="list">
          {
            navigation.map((link) =>
              link.children ? (
                <li>
                  <button
                    type="button"
                    class="drawer__link drawer__disclosure"
                    aria-expanded="false"
                    data-disclosure
                  >
                    {link.label}
                    <Icon name="chevron" size={20} class="drawer__chevron" />
                  </button>
                  <ul class="drawer__sub" role="list" data-disclosure-panel hidden>
                    {link.children.map((child) => (
                      <li>
                        <a class="drawer__sublink" href={child.href}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a
                    class:list={[
                      'drawer__link',
                      isCurrent(link.href) && 'is-current',
                    ]}
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <Button label="Take a Test Drive" href="/test-drive" variant="light" />
    </div>
  </div>
</header>

<style>
  /* ---------- Shell ---------- */

  .header {
    position: absolute;
    inset-inline: 0;
    top: var(--sp-24);
    z-index: var(--z-header);
  }

  /* Once the page has scrolled past the hero the header pins itself so the
     9000px+ pages keep their navigation. Not in the Figma, which only shows
     the resting state. */
  .header.is-pinned {
    position: fixed;
    top: 0;
    padding-block: var(--sp-12);
    background-color: var(--c-ink);
    box-shadow: var(--shadow-lg);
    animation: header-drop var(--dur) var(--ease-out);
  }

  @keyframes header-drop {
    from {
      transform: translateY(-100%);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-32);
    width: 100%;
    max-width: calc(var(--container) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .header__logo {
    font-family: var(--font-brand);
    font-size: 1.625rem; /* 26 */
    font-weight: var(--fw-bold);
    line-height: 1.2;
    color: var(--c-primary);
    flex: none;
  }

  /* ---------- Desktop nav ---------- */

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-32);
    margin: 0;
    padding: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0;
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-cream);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__link.is-current,
  .nav__link:hover {
    color: var(--c-primary);
  }

  .nav__chevron {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .nav__trigger[aria-expanded='true'] .nav__chevron {
    transform: rotate(180deg);
  }

  /* ---------- Dropdown (Figma #266:15306) ---------- */

  .dropdown {
    position: absolute;
    top: calc(100% + var(--sp-12));
    left: 50%;
    z-index: var(--z-dropdown);
    display: flex;
    flex-direction: column;
    width: 150px;
    margin: 0;
    padding: 0;
    background-color: var(--c-surface);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -6px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility var(--dur-fast);
  }

  .nav__item--has-menu:hover .dropdown,
  .nav__item--has-menu:focus-within .dropdown,
  .dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .dropdown__link {
    display: block;
    /* Figma: 12px 16px */
    padding: var(--sp-12) var(--sp-16);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-ink);
    border-radius: var(--r-md);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .dropdown__link:hover,
  .dropdown__link:focus-visible,
  .dropdown__link.is-current {
    background-color: var(--c-primary);
  }

  /* ---------- Mobile toggle ---------- */

  .header__toggle,
  .drawer__close {
    display: none;
    padding: var(--sp-8);
    color: var(--c-cream);
  }

  /* ---------- Drawer ---------- */

  .drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    background-color: rgba(19, 20, 0, 0.6);
  }

  .drawer[hidden] {
    display: none;
  }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-32);
    width: min(22rem, 88vw);
    height: 100%;
    margin-left: auto;
    padding: var(--sp-24) var(--sp-24) var(--sp-48);
    background-color: var(--c-ink);
    overflow-y: auto;
    animation: drawer-in var(--dur) var(--ease-out);
  }

  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .drawer__nav {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-8);
    width: 100%;
    padding: var(--sp-12) 0;
    font-size: var(--fs-h6);
    font-weight: var(--fw-medium);
    color: var(--c-cream);
    text-align: left;
  }

  .drawer__link.is-current,
  .drawer__link:hover {
    color: var(--c-primary);
  }

  .drawer__disclosure[aria-expanded='true'] .drawer__chevron {
    transform: rotate(180deg);
  }

  .drawer__chevron {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .drawer__sub {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
    margin: 0;
    padding: 0 0 var(--sp-12) var(--sp-16);
    border-left: 1px solid rgba(244, 243, 239, 0.2);
  }

  .drawer__sub[hidden] {
    display: none;
  }

  .drawer__sublink {
    display: block;
    padding: var(--sp-8) var(--sp-12);
    color: var(--c-cream);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .drawer__sublink:hover {
    color: var(--c-primary);
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 1100px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__toggle,
    .drawer__close {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-drawer-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-drawer-close]');

  /* ---------- Mobile drawer ---------- */

  const FOCUSABLE =
    'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  let lastFocused: HTMLElement | null = null;

  function openDrawer(): void {
    if (!drawer || !toggle) return;
    lastFocused = document.activeElement as HTMLElement;
    drawer.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    drawer.querySelector<HTMLElement>(FOCUSABLE)?.focus();
  }

  function closeDrawer(): void {
    if (!drawer || !toggle) return;
    drawer.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  // Clicking the scrim (but not the panel) closes the drawer.
  drawer?.addEventListener('click', (event) => {
    if (event.target === drawer) closeDrawer();
  });

  document.addEventListener('keydown', (event) => {
    if (!drawer || drawer.hidden) return;

    if (event.key === 'Escape') {
      closeDrawer();
      return;
    }

    if (event.key !== 'Tab') return;

    // Keep focus inside the drawer while it is open.
    const items = Array.from(drawer.querySelectorAll<HTMLElement>(FOCUSABLE));
    if (items.length === 0) return;

    const first = items[0]!;
    const last = items[items.length - 1]!;

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  /* ---------- Drawer disclosures ---------- */

  document.querySelectorAll<HTMLButtonElement>('[data-disclosure]').forEach((button) => {
    button.addEventListener('click', () => {
      const panel = button.nextElementSibling as HTMLElement | null;
      if (!panel) return;
      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  /* ---------- Desktop dropdown ----------
     Hover and focus-within are handled in CSS; this adds click/keyboard
     control and reports state through aria-expanded. */

  document
    .querySelectorAll<HTMLButtonElement>('[data-dropdown-trigger]')
    .forEach((trigger) => {
      const menu = trigger.nextElementSibling as HTMLElement | null;
      if (!menu) return;

      const setOpen = (open: boolean): void => {
        trigger.setAttribute('aria-expanded', String(open));
        menu.classList.toggle('is-open', open);
      };

      trigger.addEventListener('click', () => {
        setOpen(trigger.getAttribute('aria-expanded') !== 'true');
      });

      trigger.parentElement?.addEventListener('mouseenter', () => setOpen(true));
      trigger.parentElement?.addEventListener('mouseleave', () => setOpen(false));

      trigger.parentElement?.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !trigger.parentElement?.contains(next)) setOpen(false);
      });

      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(false);
          trigger.focus();
        }
      });
    });

  /* ---------- Pin on scroll ---------- */

  if (header) {
    // Pin once the header would otherwise have scrolled out of view.
    const threshold = 200;
    let pinned = false;

    const onScroll = (): void => {
      const shouldPin = window.scrollY > threshold;
      if (shouldPin !== pinned) {
        pinned = shouldPin;
        header.classList.toggle('is-pinned', shouldPin);
      }
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

---
/**
 * The article column of a blog post — Figma #263:981.
 *
 * The frame sets body copy in a 684 measure centred in the 1600 frame, which
 * is the same axis as the 1400 container, so this centres itself rather than
 * living inside one. Figures break out of that measure and are handled in
 * their own component.
 *
 * Everything here is `:global()` under `.prose`: the markdown arrives through
 * a slot, so it carries the *page's* scope attribute, never this component's.
 * Written plainly the rules would match nothing at all.
 *
 * The frame only shows paragraphs and one 36/700 heading. The rest of the
 * markdown vocabulary is styled anyway — a template is bought to be written
 * in, and an unstyled list or blockquote is a hole in the product.
 *
 * ---------------------------------------------------------------------------
 * IMAGES
 *
 * The frame breaks pictures out of the measure in two ways, and both are
 * driven by how many images a markdown paragraph holds — no component, no
 * class, no HTML in the post:
 *
 *   ![alt](./a.webp) ![alt](./b.webp)   two on one line  → the 1042 + 326
 *                                         pair, breaking out to the 1400
 *                                         container (#261:959, #263:978)
 *
 *   ![alt](./c.webp)                    one on its own   → the full-bleed
 *                                         1600 x 780 band (#85:130)
 *
 * Markdown puts each of those in its own `<p>`, so `:has()` can tell them
 * apart. Keeping it to markdown syntax rather than raw HTML is what preserves
 * Astro's image pipeline — a hand-written `<img src="./x">` in a post is not
 * resolved or optimised — and it is what a CMS can round-trip.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    /* Three nested tracks, so a picture can leave the measure without leaving
       the flow: text keeps the frame's 684, a pair reaches the 1400
       container, and a lone image goes edge to edge. The gutter is here
       rather than on the page, or `full` could never reach the edge. */
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [wide-start] minmax(0, calc((var(--container) - var(--measure)) / 2))
      [text-start] min(var(--measure), 100% - var(--gutter) * 2)
      [text-end] minmax(0, calc((var(--container) - var(--measure)) / 2))
      [wide-end] minmax(var(--gutter), 1fr) [full-end];
    /* 684, the frame's measure. */
    --measure: 42.75rem;
    font-size: var(--fs-lead); /* 20 */
    line-height: var(--lh-body);
    color: var(--c-ink);
  }

  .prose > :global(*) {
    grid-column: text;
  }

  /* Grid items do not margin-collapse, so every gap is stated once by the
     element below it rather than shared between neighbours. */
  .prose > :global(* + *) {
    margin-top: var(--sp-20);
  }

  /* Figma #263:976: 60 between the paragraph above and the heading. */
  .prose :global(h2),
  .prose :global(h3) {
    margin-top: 3.75rem; /* 60 */
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
  }

  .prose :global(h2) {
    font-size: var(--fs-h4); /* 36 */
  }

  .prose :global(h3) {
    font-size: var(--fs-h5); /* 32 */
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  /* ---------- Figures ---------- */

  /* Figma #263:981: 80 clear of the copy on both sides. `:has()` outranks the
     heading's 60 on specificity, which is what lets a picture follow a
     heading at the section rhythm rather than the paragraph one. */
  .prose > :global(p:has(img)),
  .prose > :global(p:has(img) + *) {
    margin-top: var(--sp-80);
  }

  .prose > :global(p:has(img)) {
    grid-column: wide;
  }

  /* Figma #261:959 and #263:978 — 1042 + 32 + 326 is exactly the 1400
     container, so the two tracks need no maths beyond their own widths. */
  .prose > :global(p:has(img + img)) {
    display: grid;
    grid-template-columns: 1042fr 326fr;
    gap: var(--sp-32);
    aspect-ratio: 1400 / 440;
  }

  .prose > :global(p:has(img:only-child)) {
    grid-column: full;
    /* Figma #85:130 — the same 780 band the heroes use. */
    aspect-ratio: 1600 / 780;
  }

  /* #263:977 leaves 86 under the full-bleed band where every other gap in the
     section is 80. Reproduced rather than regularised: it moves everything
     below it, and the frame is the reference. */
  .prose > :global(p:has(img:only-child) + *) {
    margin-top: 5.375rem; /* 86 */
  }

  /* The aspect-ratio above gives each box a definite height, which is what
     lets these resolve — see the CTA band, where dropping it silently broke
     the same pattern. */
  .prose :global(p:has(img) img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prose :global(p:has(img + img) img) {
    border-radius: var(--r-sm);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--sp-24);
  }

  .prose :global(li + li) {
    margin-top: var(--sp-8);
  }

  .prose :global(li::marker) {
    color: var(--c-muted);
  }

  .prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s var(--ease-out, ease);
  }

  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    color: var(--c-muted);
  }

  .prose :global(strong) {
    font-weight: var(--fw-bold);
  }

  /* The lime is a 1.05:1 fill on cream, so it draws the rule rather than the
     text — which is the only job it can hold here and still be legible. */
  .prose :global(blockquote) {
    padding-left: var(--sp-24);
    border-left: 3px solid var(--c-primary);
    font-size: var(--fs-h6); /* 24 */
    line-height: var(--lh-heading);
  }

  .prose :global(hr) {
    margin-block: var(--sp-48);
    border: 0;
    border-top: 0.5px solid var(--c-steel);
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
  }

  .prose :global(pre) {
    padding: var(--sp-24);
    border-radius: var(--r-sm);
    background-color: var(--c-ink);
    color: var(--c-cream);
    overflow-x: auto;
  }

  /* ---------- Responsive ---------- */

  /* The narrow half of a pair is 326 of 1400 — a detail shot, and it holds
     down to about 160px. Past that it is a thumbnail, so the pair stacks and
     both pictures take the same landscape crop rather than one of them
     arriving full-width and portrait. */
  @media (max-width: 768px) {
    .prose > :global(p:has(img + img)) {
      grid-template-columns: 1fr;
      gap: var(--sp-16);
      aspect-ratio: auto;
    }

    .prose :global(p:has(img + img) img) {
      aspect-ratio: 3 / 2;
      height: auto;
    }

    /* 2.05:1 is a band across a desktop page and a letterbox on a phone. */
    .prose > :global(p:has(img:only-child)) {
      aspect-ratio: 3 / 2;
    }

    .prose > :global(p:has(img)),
    .prose > :global(p:has(img) + *),
    .prose > :global(p:has(img:only-child) + *) {
      margin-top: var(--section-gap-sm);
    }
  }
</style>
